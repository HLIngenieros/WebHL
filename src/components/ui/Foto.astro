---
// Foto responsiva (especificación §6): AVIF y WebP con dimensiones fijas para no mover la página.
// `prioridad` solo para la imagen del LCP; el resto carga en diferido. Nunca más de 800 px (guía §8).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; sizes: string; prioridad?: boolean; class?: string }
const { src, alt, sizes, prioridad = false, class: clase } = Astro.props;
const widths = [480, 800].filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={widths.length ? widths : [src.width]}
  width={Math.min(800, src.width)}
  height={Math.round((Math.min(800, src.width) * src.height) / src.width)}
  formats={['avif', 'webp']}
  loading={prioridad ? 'eager' : 'lazy'}
  decoding={prioridad ? 'auto' : 'async'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  class:list={['foto', clase]}
/>

<style>
  /* Global: Picture es otro componente y no recibe el atributo de alcance. */
  :global(img.foto) { display: block; width: 100%; max-width: 800px; height: auto; background: var(--line-soft); }
</style>
