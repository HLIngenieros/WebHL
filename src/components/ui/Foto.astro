---
// Foto responsiva (especificación §6): AVIF y WebP con dimensiones fijas para no mover la página.
// `prioridad` solo para la imagen del LCP; el resto carga en diferido.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; sizes: string; prioridad?: boolean; class?: string }
const { src, alt, sizes, prioridad = false, class: clase } = Astro.props;
const widths = [480, 800, 1200].filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={widths.length ? widths : [src.width]}
  formats={['avif', 'webp']}
  loading={prioridad ? 'eager' : 'lazy'}
  decoding={prioridad ? 'sync' : 'async'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  class:list={['foto', clase]}
/>

<style>
  /* Global: Picture es otro componente y no recibe el atributo de alcance. */
  :global(img.foto) { display: block; width: 100%; height: auto; background: var(--line-soft); }
</style>
