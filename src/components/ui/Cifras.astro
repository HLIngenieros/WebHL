---
// Cifras destacadas (guía §7). El valor final va escrito en el HTML.
interface Props { items: { valor: string; etiqueta: string }[] }
const { items } = Astro.props;
---
<div class="cifras-cont">
  <dl class="cifras">
    {items.map((c) => (
      <div><dt class="voz-datos">{c.etiqueta}</dt><dd class="cifra">{c.valor}</dd></div>
    ))}
  </dl>
</div>

<style>
  .cifras-cont { container-type: inline-size; }
  .cifras {
    margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: var(--border) solid var(--line);
  }
  .cifras > div { container-type: inline-size; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--s1); padding: var(--s4) var(--s3); border-left: var(--border) solid var(--line-soft); }
  .cifras > div:nth-child(2n + 1) { border-left: 0; }
  dd {
    /* la cifra nunca se sale de su celda: se ajusta al ancho disponible, con el tamaño de la guía como tope */
    margin: 0; color: var(--accent); font-size: min(var(--fs-stat), 17cqi); font-stretch: var(--wdth-stat);
    font-weight: var(--fw-title); line-height: 1;
  }
  dt { color: var(--muted); }
  @container (min-width: 720px) {
    .cifras { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .cifras > div:nth-child(2n + 1) { border-left: var(--border) solid var(--line-soft); }
    .cifras > div:first-child { border-left: 0; }
  }
</style>
