---
// Cabecera (guía §7, maqueta design/maquetas/rediseno.html): logo, menú de 6 pestañas, ES/EN y tema, en azul
// noche en los dos temas. Sobre el hero del inicio es transparente hasta que se baja. La pestaña activa y el
// hover se marcan con una línea naranja de 2 px que se mide de izquierda a derecha. Bajo 1100 px, botón "Menú"
// que abre un panel nativo (popover: funciona sin JavaScript) con barrido.
import { MENU, ruta, par, seccionDe, type Lang } from '../i18n/rutas';
import { t } from '../i18n/ui';
import Marca from './Marca.astro';

interface Props { lang: Lang; alterno?: string; inmersa?: boolean }
const { lang, alterno, inmersa = false } = Astro.props;
const otro: Lang = lang === 'es' ? 'en' : 'es';
const hrefOtro = alterno ?? par(Astro.url.pathname);
const activa = seccionDe(Astro.url.pathname);
const actual = (k: string) => (k === activa ? 'page' : undefined);
---
<header class:list={['barra', { inmersa }]} data-inmersa={inmersa ? '' : undefined} transition:name="barra" transition:animate="none">
  <div class="barra-in">
    <a class="logo" href={ruta('inicio', lang)} aria-label="Grupo HL, inicio">
      <Marca tono="blanco" />
    </a>

    <nav id="nav-principal" aria-label={t(lang, 'menu')}>
      <ul>
        {MENU.map((k) => <li><a href={ruta(k, lang)} data-seccion={k} aria-current={actual(k)}>{t(lang, k)}</a></li>)}
      </ul>
    </nav>

    <div class="herramientas">
      <span class="idioma"><b aria-hidden="true">{lang.toUpperCase()}</b><span aria-hidden="true"> · </span><a href={hrefOtro} hreflang={otro} lang={otro}>{otro.toUpperCase()}<span class="sr-only"> · {t(lang, 'idioma')}</span></a></span>
      <button id="boton-tema" class="tema" type="button" aria-label={t(lang, 'tema')}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" /></svg>
      </button>
      <button id="boton-menu" class="boton-menu" type="button" popovertarget="menu-movil" aria-haspopup="true">{t(lang, 'menu')}</button>
    </div>
  </div>

  <div id="menu-movil" popover aria-label={t(lang, 'menu')}>
    <div class="menu-cab">
      <Marca tono="blanco" />
      <button type="button" class="cerrar" popovertarget="menu-movil" popovertargetaction="hide">{t(lang, 'cerrar')}</button>
    </div>
    <nav aria-label={t(lang, 'menu')}>
      <ul>
        {MENU.map((k, i) => (
          <li style={`--i:${i}`}><a href={ruta(k, lang)} data-seccion={k} data-astro-prefetch="viewport" aria-current={actual(k)}>{t(lang, k)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu-pie">
      <a href={hrefOtro} hreflang={otro} lang={otro}>{t(lang, 'idioma')}</a>
      <button type="button" data-tema>{t(lang, 'tema')}</button>
    </div>
  </div>
</header>

<script>
  const raiz = document.documentElement;
  const temaActual = () =>
    raiz.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const botonesTema = () => document.querySelectorAll('#boton-tema, [data-tema]');
  const marcarTema = () =>
    botonesTema().forEach((b) => b.setAttribute('aria-pressed', String(temaActual() === 'dark')));
  function alternarTema() {
    const nuevo = temaActual() === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    (window as any).__tema = nuevo; // respaldo si el almacenamiento está bloqueado: dura la visita
    try { localStorage.setItem('tema', nuevo); } catch { /* bloqueado */ }
    marcarTema();
  }

  function iniciar() {
    const menu = document.getElementById('menu-movil');
    const boton = document.getElementById('boton-menu');
    if (!menu || !boton || menu.dataset.listo) return;
    menu.dataset.listo = '1';
    menu.addEventListener('toggle', (e) => boton.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
    boton.setAttribute('aria-expanded', 'false');
    botonesTema().forEach((b) => b.addEventListener('click', alternarTema));
    marcarTema();
  }

  // Barra inmersa (solo el inicio): transparente mientras el hero está bajo la barra.
  let observador: IntersectionObserver | null = null;
  function inmersa() {
    observador?.disconnect();
    observador = null;
    (window as any).__barraObs = 0;
    const barra = document.querySelector<HTMLElement>('header.barra[data-inmersa]');
    const hero = document.querySelector('.hero');
    if (!barra || !hero) return;
    const alto = barra.offsetHeight;
    observador = new IntersectionObserver(([e]) => {
      barra.classList.toggle('inmersa', e.isIntersecting);
      raiz.classList.toggle('barra-inmersa', e.isIntersecting);
    }, { rootMargin: `-${alto}px 0px 0px 0px` });
    observador.observe(hero);
    (window as any).__barraObs = 1;
  }

  iniciar();
  inmersa();
  document.addEventListener('astro:page-load', () => { iniciar(); inmersa(); });
  document.addEventListener('astro:before-swap', () => {
    const menu = document.getElementById('menu-movil');
    if (menu?.matches(':popover-open')) menu.hidePopover();
    observador?.disconnect();
    observador = null;
    (window as any).__barraObs = 0;
  });
</script>

<style>
  /* Primitivos de marca: la cabecera es azul noche en los dos temas. */
  .barra {
    position: sticky; top: 0; z-index: 50; color: var(--hl-blanco); background: var(--azul-900);
    transition: background-color var(--t-aparece) ease, box-shadow var(--t-aparece) ease;
  }
  .barra:not(.inmersa) { box-shadow: 0 8px 24px -14px rgba(0, 0, 0, .6); }
  .barra-in {
    max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); box-sizing: content-box;
    height: var(--bar-h); display: flex; align-items: center; gap: var(--s5);
  }
  .logo { display: flex; align-items: center; color: var(--hl-blanco); text-decoration: none; margin-right: auto; }

  /* Solo el inicio: fija y transparente sobre el hero */
  .barra[data-inmersa] { position: fixed; left: 0; right: 0; }
  .barra.inmersa { background: transparent; }

  #nav-principal { display: none; }
  #nav-principal ul { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  #nav-principal a {
    position: relative; display: block; padding: 10px 0; color: var(--azul-50); text-decoration: none; white-space: nowrap;
    font-family: var(--f-titulo); font-weight: var(--fw-fina); font-size: var(--fs-boton); line-height: 1;
  }
  #nav-principal a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px; background: var(--hl-naranja);
    transform: scaleX(0); transform-origin: left; transition: transform var(--t-aparece) var(--ease-plano);
  }
  #nav-principal a:is(:hover, [aria-current='page'])::after { transform: scaleX(1); }
  #nav-principal a[aria-current='page'] { color: var(--hl-blanco); }
  #nav-principal a:focus-visible { outline: 2px solid var(--hl-naranja); outline-offset: 4px; }

  .herramientas { display: flex; align-items: center; gap: var(--s2); }
  .idioma { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; color: var(--noche-tenue); font-family: var(--f-titulo); font-weight: var(--fw-fina); font-size: var(--fs-sm); }
  .idioma b { color: var(--hl-blanco); font-weight: var(--fw-fina); }
  .idioma a { color: inherit; text-decoration: none; padding: var(--s2) 2px; }
  .idioma a:hover { color: var(--hl-blanco); }
  .tema {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    background: none; border: 0; color: var(--noche-tenue); cursor: pointer; transition: color var(--t-rapido) ease;
  }
  .tema:hover { color: var(--hl-blanco); }
  :is(.tema, .idioma a, .boton-menu, .cerrar, .menu-pie :is(a, button)):focus-visible { outline: 2px solid var(--hl-naranja); outline-offset: 2px; }
  .boton-menu, .cerrar, .menu-pie button {
    min-height: 44px; padding: 0 var(--s3); background: none; color: var(--hl-blanco); cursor: pointer;
    border: var(--border) solid color-mix(in srgb, var(--hl-blanco) 40%, transparent); border-radius: var(--radius);
    font-family: var(--f-mono); font-weight: var(--fw-data); font-size: var(--fs-data); letter-spacing: var(--ls-data); text-transform: uppercase;
  }
  @media (max-width: 1099.98px) { .idioma { display: none; } }
  @media (min-width: 1100px) {
    #nav-principal { display: block; }
    .boton-menu { display: none; }
  }

  /* Menú móvil: panel nativo que entra con barrido de derecha a izquierda */
  #menu-movil {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    box-sizing: border-box; overflow-y: auto; background: var(--azul-900); color: var(--hl-blanco);
    clip-path: inset(0 0 0 0);
    transition: clip-path var(--t-vista) var(--ease-barrido), display var(--t-vista) allow-discrete, overlay var(--t-vista) allow-discrete;
  }
  #menu-movil:not(:popover-open) { clip-path: inset(0 0 0 100%); }
  @starting-style { #menu-movil:popover-open { clip-path: inset(0 0 0 100%); } }
  .menu-cab {
    height: var(--bar-h); display: flex; align-items: center; justify-content: space-between;
    padding-inline: var(--gutter); border-bottom: var(--border) solid color-mix(in srgb, var(--hl-blanco) 12%, transparent);
  }
  #menu-movil ul { list-style: none; margin: 0; padding: var(--s4) var(--gutter); }
  #menu-movil li { border-bottom: var(--border) solid color-mix(in srgb, var(--hl-blanco) 10%, transparent); }
  #menu-movil li a {
    position: relative; display: flex; align-items: center; padding: var(--s3) 0; color: var(--hl-blanco); text-decoration: none;
    font-size: var(--fs-h2); font-family: var(--f-titulo); font-weight: var(--fw-title); line-height: var(--lh-title);
  }
  #menu-movil li a[aria-current='page'] { color: var(--hl-naranja); }
  #menu-movil:popover-open li { animation: izaje-menu var(--t-izaje) var(--ease-izaje) both; animation-delay: calc(var(--i) * 40ms + .15s); }
  @keyframes izaje-menu { from { opacity: 0; transform: translateY(12px); } }
  .menu-pie { display: flex; align-items: center; gap: var(--s3); padding: var(--s3) var(--gutter); }
  .menu-pie a { min-height: 44px; display: inline-flex; align-items: center; color: var(--hl-trazo); }
  @media (prefers-reduced-motion: reduce) {
    #nav-principal a::after, .barra { transition: none; }
    #menu-movil { transition: none; }
    #menu-movil:popover-open li { animation: none; }
  }
</style>
