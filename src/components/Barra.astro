---
// Barra superior (guía §7 y §13.1): logo, menú con el submenú de Proyectos, idioma y tema. Bajo 1100 px,
// menú a pantalla completa.
import { MENU, BAJO_PROYECTOS, ruta, par, seccionDe, type ClaveRuta, type Lang } from '../i18n/rutas';
import { t } from '../i18n/ui';
import Marca from './Marca.astro';
import PanelProyectos from './PanelProyectos.astro';

interface Props { lang: Lang; alterno?: string; inmersa?: boolean }
const { lang, alterno, inmersa = false } = Astro.props;
const otro: Lang = lang === 'es' ? 'en' : 'es';
const hrefOtro = alterno ?? par(Astro.url.pathname);
const activa = seccionDe(Astro.url.pathname);
const menu = MENU;
// En Servicios y Sectores se marca Proyectos, de donde cuelgan (aria-current="true", no "page").
const actual = (k: ClaveRuta) => (k === activa ? 'page' : k === 'proyectos' && activa && BAJO_PROYECTOS.includes(activa) ? 'true' : undefined);
---
<header class:list={['barra', { inmersa }]} data-inmersa={inmersa ? '' : undefined} transition:name="barra" transition:animate="none">
  <div class="barra-in">
    <a class="logo" href={ruta('inicio', lang)} aria-label="HL Ingenieros, inicio">
      <Marca />
    </a>

    <nav id="nav-principal" aria-label={t(lang, 'menu')}>
      <ul>
        {menu.map((k, i) => (
          <li class:list={{ 'con-panel': k === 'proyectos' }}>
            <a href={ruta(k, lang)} data-seccion={k} aria-current={actual(k)}><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{t(lang, k)}</a>
            {k === 'proyectos' && (
              <button type="button" class="desplegar" data-seccion="proyectos" aria-expanded="false" aria-controls="panel-proyectos" aria-label={t(lang, 'sectoresYServicios')} hidden>
                <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </button>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="herramientas">
      {inmersa && <a class="hablar-barra voz-datos" href={ruta('contacto', lang)}><i aria-hidden="true"></i>{t(lang, 'hablar')}</a>}
      <a class="idioma" href={hrefOtro} hreflang={otro} lang={otro}>{otro.toUpperCase()}<span class="sr-only"> · {t(lang, 'idioma')}</span></a>
      <button id="boton-tema" class="tema" type="button" aria-label={t(lang, 'tema')}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" /></svg>
      </button>
      <a id="boton-menu" class="boton-menu" href="#navegacion-pie">{t(lang, 'menu')}</a>
    </div>
  </div>

  <PanelProyectos lang={lang} id="panel-proyectos" />

  <dialog id="menu-movil" aria-label={t(lang, 'menu')}>
    <div class="menu-cab">
      <span class="voz-datos">{t(lang, 'menu')}</span>
      <button type="button" class="cerrar voz-datos" data-cerrar>{t(lang, 'cerrar')}</button>
    </div>
    <ul>
      {menu.map((k, i) => (
        <li style={`--i:${i}`}>
          <div class="fila">
            <a href={ruta(k, lang)} data-seccion={k} data-astro-prefetch="viewport" aria-current={actual(k)}>{t(lang, k)}</a>
            {k === 'proyectos' && (
              <button type="button" class="desplegar-movil" data-seccion="proyectos" aria-expanded="false" aria-controls="sub-proyectos" aria-label={t(lang, 'sectoresYServicios')}>+</button>
            )}
          </div>
          {k === 'proyectos' && <PanelProyectos lang={lang} id="sub-proyectos" movil />}
        </li>
      ))}
    </ul>
    <div class="menu-pie">
      <a href={hrefOtro} hreflang={otro} lang={otro} class="voz-datos">{t(lang, 'idioma')}</a>
      <button type="button" class="voz-datos" data-tema>{t(lang, 'tema')}</button>
    </div>
  </dialog>
</header>

<script>
  const raiz = document.documentElement;
  const temaActual = () =>
    raiz.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const botonesTema = () => document.querySelectorAll('#boton-tema, [data-tema]');
  const marcarTema = () =>
    botonesTema().forEach((b) => b.setAttribute('aria-pressed', String(temaActual() === 'dark')));
  function alternarTema() {
    const nuevo = temaActual() === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    (window as any).__tema = nuevo; // respaldo si el almacenamiento está bloqueado: dura la visita
    try { localStorage.setItem('tema', nuevo); } catch { /* bloqueado */ }
    marcarTema();
  }

  function iniciar() {
    const menu = document.getElementById('menu-movil') as HTMLDialogElement | null;
    const enlace = document.getElementById('boton-menu');
    if (!menu || !enlace || menu.dataset.listo) return;
    menu.dataset.listo = '1';
    // Sin JS es un enlace al menú del pie; con JS pasa a ser un botón real que abre el diálogo.
    const boton = document.createElement('button');
    boton.type = 'button';
    for (const { name, value } of enlace.attributes) if (name !== 'href') boton.setAttribute(name, value);
    boton.textContent = enlace.textContent;
    boton.setAttribute('aria-controls', 'menu-movil');
    boton.setAttribute('aria-haspopup', 'dialog');
    boton.setAttribute('aria-expanded', 'false');
    enlace.replaceWith(boton);
    boton.addEventListener('click', () => { menu.showModal(); boton.setAttribute('aria-expanded', 'true'); });
    menu.querySelector('[data-cerrar]')?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => { boton.setAttribute('aria-expanded', 'false'); boton.focus(); });
    botonesTema().forEach((b) => b.addEventListener('click', alternarTema));
    marcarTema();
  }

  // Submenú de Proyectos (guía §13.1): botón aparte, nunca al pasar el cursor. Sin JS el botón no existe y
  // "Proyectos" sigue siendo un enlace; Servicios y Sectores quedan en el pie.
  let cerrarPanel = () => {};
  function panel() {
    const boton = document.querySelector<HTMLButtonElement>('.desplegar');
    const caja = document.getElementById('panel-proyectos');
    if (!boton || !caja || caja.dataset.listo) return;
    caja.dataset.listo = '1';
    const grupo = boton.closest('li')!;
    boton.hidden = false;
    caja.hidden = false;
    caja.inert = true;
    const trazar = (el: Element) => { el.classList.remove('visible'); void (el as HTMLElement).offsetWidth; el.classList.add('visible'); };
    const poner = (abierto: boolean, foco = false) => {
      if (abierto === caja.hasAttribute('data-abierto')) return;
      caja.toggleAttribute('data-abierto', abierto);
      grupo.toggleAttribute('data-abierto', abierto);
      boton.setAttribute('aria-expanded', String(abierto));
      caja.inert = !abierto;
      if (abierto) caja.querySelectorAll('.trazo').forEach(trazar);
      else if (foco) boton.focus();
    };
    cerrarPanel = () => poner(false);
    boton.addEventListener('click', () => poner(!caja.hasAttribute('data-abierto')));
    boton.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown') return;
      e.preventDefault();
      poner(true);
      caja.querySelector('a')?.focus();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && caja.hasAttribute('data-abierto')) poner(false, true); });
    document.addEventListener('pointerdown', (e) => {
      const en = e.target as Node;
      if (!caja.contains(en) && !grupo.contains(en)) poner(false);
    });
    for (const el of [grupo, caja]) el.addEventListener('focusout', (e) => {
      const destino = (e as FocusEvent).relatedTarget as Node | null;
      if (destino && !caja.contains(destino) && !grupo.contains(destino)) poner(false);
    });
    caja.querySelectorAll('.principales a').forEach((a) => a.addEventListener('mouseenter', () => a.querySelectorAll('.trazo').forEach(trazar)));
    // Menú móvil: Proyectos despliega sectores y servicios.
    const mas = document.querySelector<HTMLButtonElement>('.desplegar-movil');
    const sub = document.getElementById('sub-proyectos');
    mas?.addEventListener('click', () => {
      const abrir = mas.getAttribute('aria-expanded') !== 'true';
      mas.setAttribute('aria-expanded', String(abrir));
      mas.textContent = abrir ? '−' : '+';
      if (sub) sub.hidden = !abrir;
    });
  }

  // Barra inmersa (guía §7): solo en el inicio. Mientras el hero está bajo la barra, va inmersa y lleva
  // "Hablar con HL"; al salir, pasa a la barra normal y vuelve el botón flotante.
  let observador: IntersectionObserver | null = null;
  function inmersa() {
    observador?.disconnect();
    observador = null;
    (window as any).__barraObs = 0;
    const barra = document.querySelector<HTMLElement>('header.barra[data-inmersa]');
    const hero = document.querySelector('.hero');
    if (!barra || !hero) return;
    const alto = barra.offsetHeight;
    observador = new IntersectionObserver(([e]) => {
      barra.classList.toggle('inmersa', e.isIntersecting);
      raiz.classList.toggle('barra-inmersa', e.isIntersecting);
    }, { rootMargin: `-${alto}px 0px 0px 0px` });
    observador.observe(hero);
    (window as any).__barraObs = 1;
  }

  iniciar();
  panel();
  inmersa();
  document.addEventListener('astro:page-load', () => { iniciar(); panel(); inmersa(); });
  document.addEventListener('astro:before-swap', () => {
    cerrarPanel();
    (document.getElementById('menu-movil') as HTMLDialogElement | null)?.close();
    observador?.disconnect();
    observador = null;
    (window as any).__barraObs = 0;
  });
</script>

<style>
  .barra {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--border) solid var(--line);
  }
  .barra-in {
    max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); box-sizing: content-box;
    height: var(--bar-h); display: flex; align-items: center; gap: var(--s4);
  }
  .logo { display: flex; align-items: center; gap: var(--s2); color: var(--ink); text-decoration: none; margin-right: auto; }

  #nav-principal { display: none; }
  #nav-principal ul { display: flex; gap: var(--s1); list-style: none; margin: 0; padding: 0; }
  #nav-principal a, .idioma, .boton-menu {
    font-stretch: var(--wdth-data); font-weight: var(--fw-data); font-size: var(--fs-data);
    letter-spacing: var(--ls-data); text-transform: uppercase; text-decoration: none; white-space: nowrap;
    color: var(--muted); padding: 6px 9px; border: var(--border) solid transparent;
    transition: color var(--t-rapido) ease, border-color var(--t-rapido) ease;
  }
  #nav-principal a:hover, .idioma:hover, .boton-menu:hover { color: var(--ink); border-color: var(--line); }
  /* La sección activa lleva su acento (guía §3.5): cada enlace declara su sección. */
  #nav-principal a[aria-current='page'] { color: var(--sec); border-bottom-color: var(--sec); box-shadow: inset 0 -2px var(--sec); }

  /* Submenú de Proyectos (guía §13.1) */
  #nav-principal li { display: flex; align-items: stretch; }
  #nav-principal .con-panel > a { padding-right: 4px; }
  .desplegar {
    display: grid; place-items: center; width: 28px; padding: 0; background: none; cursor: pointer;
    color: var(--muted); border: var(--border) solid transparent; transition: color var(--t-rapido) ease, border-color var(--t-rapido) ease;
  }
  .desplegar[hidden] { display: none; }
  .desplegar svg { transition: transform var(--t-rapido) var(--ease-plano); }
  .desplegar:hover { color: var(--ink); border-color: var(--line); }
  #nav-principal .con-panel[data-abierto] > a, .con-panel[data-abierto] .desplegar { color: var(--sec); }
  .con-panel[data-abierto] .desplegar { border-color: var(--sec); }
  .con-panel[data-abierto] .desplegar svg { transform: rotate(180deg); }
  #nav-principal a[aria-current='true'] { color: var(--sec); border-bottom-color: var(--sec); box-shadow: inset 0 -2px var(--sec); }
  .barra.inmersa .desplegar { color: var(--hl-concreto); }
  .barra.inmersa .con-panel[data-abierto] .desplegar { color: var(--hl-senal); border-color: var(--hl-senal); }

  .herramientas { display: flex; align-items: center; gap: var(--s1); }
  #nav-principal .num, .hablar-barra { display: none; }

  /* ── Variante inmersa (solo el inicio): sin fondo, dentro del marco de lámina del hero ── */
  .barra[data-inmersa] { position: fixed; left: 0; right: 0; transition: background-color var(--t-aparece) ease; }
  .barra.inmersa {
    background: transparent; backdrop-filter: none; border-bottom-color: transparent;
    transform: translateY(var(--s3)); color: var(--hl-blanco);
  }
  .barra.inmersa .logo, .barra.inmersa .tema, .barra.inmersa .boton-menu { color: var(--hl-blanco); }
  .barra.inmersa .logo :global(.marca-mono) { color: var(--hl-blanco); }
  .barra.inmersa .boton-menu { border-color: color-mix(in srgb, var(--hl-blanco) 35%, transparent); }
  .barra.inmersa .idioma { color: var(--hl-acero); }
  /* Cota bajo la barra: se mide al cargar, con topes en los extremos. */
  .barra.inmersa .barra-in { position: relative; }
  .barra.inmersa .barra-in::after {
    content: ""; position: absolute; left: var(--gutter); right: var(--gutter); bottom: 0; height: 1px;
    background: color-mix(in srgb, var(--hl-acero) 40%, transparent); transform-origin: left;
    animation: cota-barra 1.1s var(--ease-plano) .2s both;
  }
  .barra.inmersa .barra-in::before {
    content: ""; position: absolute; left: var(--gutter); right: var(--gutter); bottom: -4px; height: 9px;
    border-inline: 1px solid color-mix(in srgb, var(--hl-acero) 50%, transparent);
  }
  @keyframes cota-barra { from { transform: scaleX(0); } }
  @media (min-width: 1100px) {
    .barra.inmersa #nav-principal a {
      color: var(--hl-concreto); text-transform: none; letter-spacing: 0; font-stretch: var(--wdth-text);
      font-weight: var(--fw-text); font-size: var(--fs-sm); border-color: transparent; position: relative;
    }
    .barra.inmersa #nav-principal .num {
      display: inline; margin-right: 4px; vertical-align: 4px; color: var(--hl-senal);
      font-stretch: var(--wdth-data); font-weight: var(--fw-data); font-size: var(--fs-chip); letter-spacing: var(--ls-data);
    }
    .barra.inmersa #nav-principal a::after {
      content: ""; position: absolute; left: 9px; right: 9px; bottom: 2px; height: 1px; background: var(--hl-senal);
      transform: scaleX(0); transform-origin: left; transition: transform var(--t-rapido) var(--ease-plano);
    }
    .barra.inmersa #nav-principal a:hover::after { transform: scaleX(1); }
    .barra.inmersa .hablar-barra {
      display: inline-flex; align-items: center; gap: var(--s2); min-height: 44px; padding: 0 var(--s3); margin-left: var(--s2); white-space: nowrap;
      border: var(--border) solid color-mix(in srgb, var(--hl-senal) 60%, transparent); color: var(--hl-blanco); text-decoration: none;
    }
    .hablar-barra i { width: 7px; height: 7px; border-radius: 50%; background: var(--hl-senal); animation: titila 2s ease-in-out infinite; }
    @keyframes titila { 50% { opacity: .25; } }
    /* El botón flotante se esconde mientras la barra lleva el suyo. */
    :global(html.barra-inmersa #hablar) { visibility: hidden; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .barra.inmersa .barra-in::after, .hablar-barra i { animation: none; }
  }
  .tema {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    background: none; border: 0; color: var(--muted); cursor: pointer;
    transition: color var(--t-rapido) ease;
  }
  .tema:hover { color: var(--ink); }
  .idioma, .boton-menu { min-height: 44px; display: inline-flex; align-items: center; box-sizing: border-box; }
  .boton-menu { color: var(--ink); border-color: var(--line); background: none; font-family: inherit; cursor: pointer; }

  @media (min-width: 1100px) {
    #nav-principal { display: block; }
    .boton-menu { display: none; }
  }

  dialog {
    width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: var(--bg); color: var(--ink);
    clip-path: inset(0 0 0 0);
    transition: clip-path var(--t-aparece) var(--ease-barrido), display var(--t-aparece) allow-discrete, overlay var(--t-aparece) allow-discrete;
  }
  dialog:not([open]) { clip-path: inset(0 0 100% 0); }
  @starting-style { dialog[open] { clip-path: inset(0 0 100% 0); } }
  dialog::backdrop { background: transparent; }
  .menu-cab {
    height: var(--bar-h); display: flex; align-items: center; justify-content: space-between;
    padding-inline: var(--gutter); border-bottom: var(--border) solid var(--line); color: var(--muted);
  }
  .cerrar, .menu-pie button {
    min-height: 44px; background: none; border: var(--border) solid var(--line); color: var(--ink);
    padding: 0 var(--s3); cursor: pointer; font-family: inherit;
  }
  dialog ul { list-style: none; margin: 0; padding: var(--s4) var(--gutter); }
  dialog li { border-bottom: var(--border) solid var(--line-soft); }
  dialog li a {
    display: flex; align-items: center; gap: var(--s3); padding: var(--s3) 0; color: var(--ink); text-decoration: none;
    font-size: var(--fs-h2); font-stretch: var(--wdth-title); font-family: var(--f-ancha); font-weight: var(--fw-title); line-height: var(--lh-title);
  }
  dialog li a::before { content: ''; width: 6px; height: 6px; background: var(--sec); flex: none; }
  dialog .fila { display: flex; align-items: center; justify-content: space-between; gap: var(--s3); }
  dialog .fila a { flex: 1; }
  .desplegar-movil {
    width: 44px; height: 44px; flex: none; background: none; cursor: pointer; font-family: inherit; font-size: var(--fs-lead);
    color: var(--sec); border: var(--border) solid var(--sec);
  }
  dialog li a[aria-current='true'] { color: var(--sec); }
  dialog li a[aria-current='page'] { color: var(--sec); }
  dialog[open] li { animation: izaje-menu var(--t-izaje) var(--ease-izaje) both; animation-delay: calc(var(--i) * 40ms); }
  @keyframes izaje-menu { from { opacity: 0; transform: translateY(12px); } }
  .menu-pie { display: flex; gap: var(--s3); padding: var(--s3) var(--gutter); }
  .menu-pie a { min-height: 44px; display: inline-flex; align-items: center; color: var(--accent); }
</style>
