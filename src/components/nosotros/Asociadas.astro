---
// Empresas asociadas (guía §12.2-6): celdas con código E-0n y área; el logo pasa de gris a color al pasar.
// Solo las aprobadas en lanzamiento (D1); en desarrollo, marcadas.
import Pod from '../Pod.astro';
import Chip from '../ui/Chip.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type A = { nombre: string; logo?: ImageMetadata; area?: string; descripcion?: string; aprobada: boolean };
interface Props { numero: string; titulo: string; porConfirmar: string; asociadas: A[] }
const { numero, titulo, porConfirmar, asociadas } = Astro.props;
---
<section class="asociadas" aria-labelledby="asociadas-titulo" data-numero={numero}>
  <div class="wrap">
    <Pod forma="eje" letra={numero} nombre={titulo} />
    <h2 id="asociadas-titulo" class="sr-only">{titulo}</h2>
    {asociadas.some((x) => !x.aprobada) && <p class="aviso"><Chip tipo="high"><span class="chip-pendiente">{porConfirmar}</span></Chip></p>}
    <ul class="asociadas-g">
      {asociadas.map((x, i) => (
        <li class="asociada">
          <p class="asociada-cab voz-datos"><span>E-{String(i + 1).padStart(2, '0')}</span>{x.area && <span>{x.area}</span>}</p>
          {x.logo ? <Image src={x.logo} alt={x.nombre} width={Math.min(240, x.logo.width)} class="asociada-logo" /> : <p class="asociada-nombre">{x.nombre}</p>}
          {x.descripcion && <p class="asociada-txt">{x.descripcion}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .asociadas { background: var(--paper); padding-block: var(--s6); }
  .aviso { margin: var(--s3) 0 0; }
  .asociadas-g { list-style: none; margin: var(--s4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); border-left: var(--border) solid var(--line); border-top: var(--border) solid var(--line); }
  .asociada { position: relative; display: flex; flex-direction: column; min-height: 180px; padding: var(--s4); background: var(--bg); border-right: var(--border) solid var(--line); border-bottom: var(--border) solid var(--line); }
  .asociada::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease-plano); }
  .asociada:hover::after { transform: scaleX(1); }
  .asociada-cab { margin: 0; display: flex; justify-content: space-between; gap: var(--s2); color: var(--muted); }
  /* Placa blanca: los logos son oscuros y deben leerse también en modo oscuro (guía §2.2: sobre un plano de color). */
  .asociada-logo { display: block; width: auto; max-width: 220px; max-height: 56px; height: auto; object-fit: contain; margin: var(--s4) 0; padding: var(--s2); background: var(--hl-blanco); box-sizing: content-box; filter: grayscale(1); opacity: .8; transition: filter var(--t-aparece), opacity var(--t-aparece); }
  .asociada:hover .asociada-logo { filter: none; opacity: 1; }
  .asociada-nombre { margin: var(--s4) 0; font-weight: var(--fw-strong); }
  .asociada-txt { margin: auto 0 0; color: var(--muted); font-size: var(--fs-sm); line-height: 1.5; }
</style>
