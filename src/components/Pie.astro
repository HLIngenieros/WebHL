---
// Pie (acta GHL-WEB-001 y guía §7): oficina principal y teléfono, enlaces complementarios, sellos ISO y redes.
// Nada más. Azul 950 en los dos temas. Los sellos son texto hasta tener las imágenes oficiales del ente
// certificador (pendiente).
import Marca from './Marca.astro';
import { PIE, ruta, type Lang } from '../i18n/rutas';
import { t, PAISES } from '../i18n/ui';
import { cargar } from '../lib/datos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const anio = new Date().getFullYear();
const { datos } = await cargar();
const sitio = datos.sitio[0]?.data;
const sede = datos.sedes.find((s) => s.id === 'bogota')?.data;
const lugar = sede ? [sede.ciudad, PAISES[sede.pais]?.[lang]].filter(Boolean).join(', ') : '';
const telefono = sede?.telefono ?? '';
const iso = datos.certificaciones.filter((c) => c.id.startsWith('iso')).sort((a, b) => parseInt(a.id.slice(4)) - parseInt(b.id.slice(4))).map((c) => c.data.norma[lang] ?? c.data.norma.es);
const ETIQUETA = { terminos: 'pieTerminos', datos: 'pieDatos', vacantes: 'pieVacantes', acreedores: 'pieAcreedores', documentos: 'pieDocumentos' } as const;
---
<footer class="pie">
  <div class="wrap pie-in">
    <div>
      <a class="pie-marca" href={ruta('inicio', lang)} aria-label={`Grupo HL · ${t(lang, 'inicio')}`}><Marca tono="blanco" /></a>
      <h2 class="tit voz-datos">{t(lang, 'oficinaPrincipal')}</h2>
      <address>
        {sede?.direccion}<br />{lugar}<br />
        <a href={`tel:${telefono.replace(/[^\d+]/g, '')}`}>{telefono}</a>
      </address>
    </div>
    <nav aria-label={t(lang, 'enlaces')}>
      <h2 class="tit voz-datos">{t(lang, 'enlaces')}</h2>
      <ul id="enlaces-pie">{PIE.map((k) => <li><a href={ruta(k, lang)}>{t(lang, ETIQUETA[k as keyof typeof ETIQUETA])}</a></li>)}</ul>
    </nav>
    <div>
      {iso.length > 0 && <>
        <h2 class="tit voz-datos">{t(lang, 'certificaciones')}</h2>
        <ul class="sellos">{iso.map((n) => <li class="voz-datos">{n}</li>)}</ul>
      </>}
      {sitio?.redes?.length && <>
        <h2 class="tit voz-datos red-tit">{t(lang, 'redes')}</h2>
        <ul>{sitio.redes.map((r) => <li><a href={r.url} rel="noopener" target="_blank">{r.red} <i aria-hidden="true">↗</i></a></li>)}</ul>
      </>}
    </div>
  </div>
  <div class="pie-base"><p class="wrap">© {anio} Grupo HL · HL Ingenieros S.A.</p></div>
</footer>

<style>
  /* Primitivos de marca: el pie es azul 950 en los dos temas. */
  .pie { background: var(--azul-950); color: var(--noche-tenue); font-size: var(--fs-sm); }
  .pie-in { display: grid; gap: var(--s5); padding-block: var(--s6) var(--s5); }
  @media (min-width: 640px) { .pie-in { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .pie-in { grid-template-columns: 1.4fr 1.2fr 1fr; } }
  .pie-marca { display: inline-flex; color: var(--hl-blanco); text-decoration: none; }
  .tit { margin: 0 0 var(--s3); color: var(--hl-trazo); }
  .pie-marca + .tit { margin-top: var(--s5); }
  .red-tit { margin-top: var(--s4); }
  address { font-style: normal; line-height: var(--lh-text); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  a { color: var(--azul-50); text-decoration: none; transition: color var(--t-rapido) ease; }
  a:hover { color: var(--hl-blanco); text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--hl-naranja); outline-offset: 2px; }
  i { font-style: normal; }
  .sellos { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .sellos li { padding: 9px 12px; color: var(--hl-blanco); border: var(--border) solid var(--azul-800); border-radius: var(--radius); }
  .pie-base { border-top: var(--border) solid var(--azul-900); }
  .pie-base p { margin: 0 auto; padding-block: var(--s3); font-size: var(--fs-xs); }
</style>
