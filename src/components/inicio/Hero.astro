---
// Hero del Home (guía v2.0 §8 y §9, maqueta R0): solo el lema sobre el video, con la capa --velo-video y botón
// de pausa. El póster es el LCP; el video (sitio.video) se agrega después del evento load, solo en escritorio,
// sin movimiento reducido ni ahorro de datos. Sin video, el póster hace un acercamiento lento.
import { Picture } from 'astro:assets';
import poster from '../../assets/proyectos/planta-columbus/1.jpg';
import { partirLema } from '../../lib/inicio';
import type { Lang } from '../../i18n/rutas';
import { t } from '../../i18n/ui';

interface Props { lang: Lang; lema: string; video?: { mp4: string; webm?: string } }
const { lang, lema, video } = Astro.props;
const { l1, l2, l3, cierre } = partirLema(lema);
---
<section class="hero" aria-labelledby="lema" data-video={video ? JSON.stringify(video) : undefined}>
  <Picture
    src={poster} alt="" widths={[640, 960, 1200]} sizes="100vw" formats={['avif', 'webp']}
    loading="eager" fetchpriority="high" class="hero-poster"
  />
  <div class="hero-velo" aria-hidden="true"></div>
  <span class="hero-umbral" aria-hidden="true"></span>
  <div class="hero-txt">
    <h1 id="lema" class="lema">
      <span class="l"><span>{l1}</span></span>{' '}
      <span class="l"><span>{l2}</span></span>{' '}
      <span class="l l3"><span>{l3}{cierre && <> <em>{cierre}</em></>}</span></span>
    </h1>
  </div>
  <button class="hero-pausa" type="button" aria-pressed="false" data-pausar={t(lang, 'pausarVideo')} data-reproducir={t(lang, 'reproducirVideo')} aria-label={t(lang, 'pausarVideo')}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-pausa" d="M4 3h3v10H4zM9 3h3v10H9z" /><path class="i-play" d="M5 3l8 5-8 5z" /></svg>
  </button>
</section>

<script>
  // Botón de pausa (acercamiento del póster o video) y carga diferida del video.
  function iniciar() {
    const hero = document.querySelector<HTMLElement>('.hero');
    const boton = hero?.querySelector<HTMLButtonElement>('.hero-pausa');
    if (!hero || !boton || hero.dataset.listo) return;
    hero.dataset.listo = '1';
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let video: HTMLVideoElement | undefined;
    const pausar = (si: boolean) => {
      hero.classList.toggle('pausado', si);
      boton.setAttribute('aria-pressed', String(si));
      boton.setAttribute('aria-label', (si ? boton.dataset.reproducir : boton.dataset.pausar) ?? '');
      if (video) si ? video.pause() : video.play().catch(() => {});
    };
    if (quieto) pausar(true);
    boton.addEventListener('click', () => pausar(!hero.classList.contains('pausado')));

    const fuentes = hero.dataset.video && JSON.parse(hero.dataset.video) as { mp4: string; webm?: string };
    const ahorro = (navigator as any).connection?.saveData;
    if (!fuentes || quieto || ahorro || !matchMedia('(min-width: 900px)').matches) return;
    const cargar = () => {
      video = Object.assign(document.createElement('video'), { muted: true, loop: true, playsInline: true, autoplay: true, preload: 'auto' });
      video.className = 'hero-video';
      video.setAttribute('aria-hidden', 'true');
      if (fuentes.webm) video.append(Object.assign(document.createElement('source'), { src: fuentes.webm, type: 'video/webm' }));
      video.append(Object.assign(document.createElement('source'), { src: fuentes.mp4, type: 'video/mp4' }));
      video.addEventListener('playing', () => hero.classList.add('con-video'), { once: true });
      hero.querySelector('.hero-velo')!.before(video);
      if (hero.classList.contains('pausado')) video.pause();
    };
    document.readyState === 'complete' ? cargar() : addEventListener('load', cargar, { once: true });
  }
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: max(560px, min(860px, 100svh)); display: flex; align-items: center;
    background: var(--azul-900); color: var(--hl-blanco);
  }
  .hero :global(.hero-poster), .hero :global(.hero-video) {
    position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover;
  }
  .hero :global(.hero-poster) { transform-origin: 60% 50%; animation: acercar 26s ease-in-out infinite alternate; }
  @keyframes acercar { from { transform: scale(1.02); } to { transform: scale(1.14) translate(-2%, -1.5%); } }
  .hero :global(.hero-video) { opacity: 0; transition: opacity var(--t-vista) ease; }
  .hero.con-video :global(.hero-video) { opacity: 1; }
  .hero.pausado :global(.hero-poster) { animation-play-state: paused; }
  /* Umbral de la barra: deja de ser transparente cuando se baja 40 px (Barra.astro lo observa). */
  .hero-umbral { position: absolute; left: 0; top: calc(var(--bar-h) + 40px); width: 1px; height: 1px; }
  .hero-velo { position: absolute; inset: 0; z-index: -1; background: var(--velo-video); }

  .hero-txt {
    width: 100%; max-width: var(--wrap); margin-inline: auto; box-sizing: border-box;
    padding: calc(var(--bar-h) + var(--s6)) var(--gutter) var(--s7);
  }
  .lema { margin: 0; max-width: 18ch; font: var(--fw-negra) var(--fs-lema) / 1.02 var(--f-titulo); letter-spacing: -.02em; }
  .lema .l { display: block; overflow: hidden; padding-bottom: .06em; }
  .lema .l > span { display: block; }
  .l3 { margin-top: var(--s3); max-width: 32ch; font-size: var(--fs-lema-datos); font-weight: var(--fw-fina); line-height: 1.3; letter-spacing: 0; color: var(--azul-50); }
  .l3 em { font-style: normal; color: var(--hl-blanco); text-decoration: underline 3px var(--hl-naranja); text-underline-offset: .3em; }
  /* Izaje del H1: cada línea sube a su sitio (solo transform; legible desde el primer pintado). */
  :global(html.js) .lema .l > span { animation: lema-iza .9s var(--ease-izaje) both; }
  :global(html.js) .lema .l:nth-child(2) > span { animation-delay: .12s; }
  :global(html.js) .lema .l3 > span { animation-delay: .24s; }
  @keyframes lema-iza { from { transform: translateY(105%); } }

  .hero-pausa {
    position: absolute; right: var(--gutter); bottom: var(--s5); width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer; color: var(--hl-blanco);
    border: var(--border) solid color-mix(in srgb, var(--hl-blanco) 50%, transparent);
    background: color-mix(in srgb, var(--azul-900) 50%, transparent);
  }
  .hero-pausa svg { width: 14px; height: 14px; fill: currentColor; }
  .hero-pausa .i-play, .hero.pausado .hero-pausa .i-pausa { display: none; }
  .hero.pausado .hero-pausa .i-play { display: inline; }

  /* En el móvil, "Hablar con HL" ocupa el pie de la pantalla: el hero termina encima de él. */
  @media (max-width: 759.98px) { .hero { min-height: max(520px, calc(100svh - var(--bar-h))); } }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero-poster) { animation: none; }
    :global(html.js) .lema .l > span { animation: none; }
  }
</style>
