---
// Franja P3 de sectores (guía §12.1-2): rayas fijas a cada lado y, entre ellas, un carril propio por
// donde corre la cinta. La segunda copia solo cierra el bucle: no se lee ni se enfoca.
import { cargar } from '../../lib/datos';
import { bloque } from '../../lib/contenido';
import { urlDe, type Lang } from '../../i18n/rutas';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { datos } = await cargar();
const sectores = [...datos.sectores].sort((a, b) => a.data.orden - b.data.orden)
  .map((s) => ({ url: urlDe('sectores', s.data.slug, lang), nombre: bloque(s.data, lang).nombre }));
---
<nav class="franja" aria-label={t(lang, 'sectores')}>
  <span class="rayas" aria-hidden="true"></span>
  <div class="via">
    <div class="cinta">
      <ul class="cinta-lista">{sectores.map((s) => <li><a href={s.url}>{s.nombre}</a></li>)}</ul>
      <ul class="cinta-copia" aria-hidden="true" inert>{sectores.map((s) => <li><a href={s.url} tabindex="-1">{s.nombre}</a></li>)}</ul>
    </div>
  </div>
  <span class="rayas rayas-fin" aria-hidden="true"></span>
</nav>

<style>
  .franja {
    display: flex; height: var(--s5); background: var(--hl-senal); color: var(--hl-grafito);
    border-block: var(--border) solid var(--hl-grafito);
  }
  .rayas {
    flex: none; width: var(--s6); position: relative; z-index: 1; border-right: var(--border) solid var(--hl-grafito);
    background: repeating-linear-gradient(-45deg, var(--hl-grafito) 0 7px, var(--hl-senal) 7px 14px);
  }
  .rayas-fin { border-right: 0; border-left: var(--border) solid var(--hl-grafito); }
  .via { flex: 1; min-width: 0; overflow: hidden; display: flex; align-items: center; }
  .cinta { display: flex; width: max-content; animation: cinta 32s linear infinite; }
  .franja:is(:hover, :focus-within) .cinta { animation-play-state: paused; }
  @keyframes cinta { to { transform: translateX(-50%); } }
  ul { display: flex; margin: 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; }
  /* Separador: rombo dibujado, no un carácter. */
  li::after { content: ""; width: 6px; height: 6px; background: var(--hl-grafito); transform: rotate(45deg); }
  a {
    display: block; padding: var(--s1) var(--s5); color: inherit; text-decoration: none; white-space: nowrap;
    font-stretch: var(--wdth-data); font-weight: var(--fw-data); font-size: var(--fs-data);
    letter-spacing: .16em; text-transform: uppercase;
  }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--hl-grafito); outline-offset: -4px; }
  @media (prefers-reduced-motion: reduce) {
    .cinta { animation: none; }
    .cinta-copia { display: none; }
    .via { overflow-x: auto; }
  }
</style>
