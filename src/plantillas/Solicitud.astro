---
// Contacto y páginas de formulario del pie (F4, D7): entrada y datos a la izquierda, formulario por hojas a
// la derecha. Contacto pide el motivo; Proveedores, Trabaje con nosotros y Buzón ético llegan con el suyo.
import Base from '../layouts/Base.astro';
import Pod from '../components/Pod.astro';
import Formulario from '../components/Formulario';
import Vacantes from '../components/Vacantes';
import { cargar } from '../lib/datos';
import { bloque, txt } from '../lib/contenido';
import { FORMULARIOS, PAGINAS, formulario, type Intencion } from '../lib/formularios';
import { ruta, type Lang } from '../i18n/rutas';
import { PAISES } from '../i18n/ui';

interface Props { lang: Lang; alterno: string; intencion: Intencion }
const { lang, alterno, intencion } = Astro.props;
const { datos } = await cargar();
const sitio = datos.sitio[0].data;
const def = formulario(intencion);
const pagina = PAGINAS[intencion];
const esContacto = intencion === 'cotizacion';
const porOrden = <X extends { data: { orden: number } }>(xs: X[]) => [...xs].sort((a, b) => a.data.orden - b.data.orden);

const opciones = {
  pais: Object.entries(PAISES).map(([c, n]) => [c, n[lang]] as [string, string]),
  servicio: porOrden(datos.servicios).map((s) => bloque(s.data, lang).nombre),
  sector: porOrden(datos.sectores).map((s) => bloque(s.data, lang).nombre),
};
const enlaces = Object.fromEntries(FORMULARIOS.map((f) => [f.id, ruta(f.ruta, lang)])) as Record<Intencion, string>;
const buzones = sitio.contacto.buzones;
const tel = (t: string) => `tel:${t.split(/[,/]/)[0].replace(/[^\d+]/g, '')}`;
---
<Base titulo={pagina.titulo[lang]} descripcion={pagina.lead[lang]} lang={lang} alterno={alterno}>
  <section class="wrap solicitud">
    <header class="cab">
      <Pod forma="rotulo" codigo={def.codigo} nombre={pagina.titulo[lang]} />
      <h1><span class="l"><span>{pagina.h1[0][lang]}</span></span> <span class="l"><span>{pagina.h1[1][lang]}</span></span></h1>
      <p class="lead aparece" style="--i:2">{pagina.lead[lang]}</p>

      {esContacto ? (
        <ul class="sedes voz-datos revela">
          {datos.sedes.map((s, i) => (
            <li style={`--i:${i}`}>
              <b>{txt(s.data.nombre, lang)} · {s.data.ciudad}</b>
              <span>{s.data.direccion}</span>
              {s.data.telefono && <a href={tel(s.data.telefono)}>{s.data.telefono}</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="buzon voz-datos aparece" style="--i:3">
          <span>{lang === 'es' ? 'Llega a' : 'Goes to'}</span> <a href={`mailto:${buzones[intencion]}`}>{buzones[intencion]}</a>
        </p>
      )}
      {esContacto && sitio.redes.length > 0 && (
        <p class="redes voz-datos">{sitio.redes.map((r) => <a href={r.url} rel="noopener" target="_blank">{r.red} ↗</a>)}</p>
      )}
    </header>

    {intencion === 'empleo' && (
      <div class="tablero-vacantes" id="vacantes">
        <Vacantes client:load lang={lang} fuente="/api/vacantes.json" />
      </div>
    )}

    <div class="caja-form aparece" id="formulario" style="--i:3">
      <Formulario client:load lang={lang} accion="/api/enviar.php" politica={ruta('datos', lang)}
        inicial={esContacto ? null : intencion} buzones={buzones} enlaces={enlaces} opciones={opciones} />
    </div>
  </section>
</Base>

<style>
  .solicitud { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s5) var(--s6); padding-block: var(--s6); align-items: start; }
  @media (max-width: 959.98px) { .solicitud { grid-template-columns: 1fr; padding-block: var(--s5); gap: var(--s5); } }
  .cab { display: grid; gap: var(--s3); align-content: start; }
  @media (min-width: 960px) { .cab { position: sticky; top: calc(var(--bar-h) + var(--s4)); } }
  h1 { margin: 0; }
  .lead { margin: 0; }
  .sedes { list-style: none; margin: var(--s3) 0 0; padding: 0; border-top: var(--border-strong) solid var(--ink); }
  .sedes li { display: grid; gap: 2px; padding: var(--s2) 0; border-bottom: var(--stroke-thin) solid var(--line); }
  .sedes span { color: var(--muted); text-transform: none; letter-spacing: 0; font-stretch: var(--wdth-text); font-weight: var(--fw-text); font-size: var(--fs-sm); }
  .sedes a, .buzon a, .redes a { color: var(--accent); text-decoration: none; }
  .sedes a:hover, .buzon a:hover, .redes a:hover { text-decoration: underline; }
  .buzon { margin: 0; padding: var(--s2) var(--s3); border-left: var(--stroke-heavy) solid var(--accent); color: var(--muted); }
  .redes { display: flex; gap: var(--s3); margin: 0; }
  /* Trabaje con nosotros: el tablero de vacantes ocupa el ancho y el formulario queda debajo. */
  .tablero-vacantes { grid-column: 1 / -1; }
  .solicitud:has(.tablero-vacantes) .cab { grid-column: 1 / -1; position: static; }
  .solicitud:has(.tablero-vacantes) .caja-form { grid-column: 1 / -1; width: 100%; max-width: 860px; scroll-margin-top: calc(var(--bar-h) + var(--s3)); }
</style>
