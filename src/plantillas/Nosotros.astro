---
// Quiénes somos (acta GHL-WEB-001 §2, especificación v2.0 §5): slogan, línea del tiempo, misión, visión y
// valores, y presencia por países sin direcciones. Sin testimonios ni empresas asociadas (R-7): sus datos
// siguen en el repo.
import Base from '../layouts/Base.astro';
import MisionVision from '../components/nosotros/MisionVision.astro';
import Valores from '../components/nosotros/Valores.astro';
import Presencia from '../components/nosotros/Presencia.astro';
import Tira from '../components/nosotros/Tira.astro';
import { cargar } from '../lib/datos';
import { txt } from '../lib/contenido';
import { hitos, type HistoriaData } from '../lib/nosotros';
import { type Lang } from '../i18n/rutas';
import { PAISES, t } from '../i18n/ui';
import type { ImageMetadata } from 'astro';

interface Props { lang: Lang; alterno: string }
const { lang, alterno } = Astro.props;
const { datos } = await cargar();
const pagina = (datos.paginas.find((p) => p.data.pagina === 'nosotros' && p.data.lang === lang)
  ?? datos.paginas.find((p) => p.data.pagina === 'nosotros' && p.data.lang === 'es'))!.data;
const sitio = datos.sitio[0].data;
const lema = txt(sitio.lema, lang)!;

// Foto actual provisional de "Hoy": Planta Columbus (no discreta, D6).
const columbus = datos.proyectos.find((x) => x.id === 'planta-columbus' && x.data.visibilidad !== 'discreta');
const lineaTiempo = hitos(datos.historia as unknown as { id: string; data: HistoriaData }[], lang, new Date(),
  { foto: columbus?.data.fotos[1]?.archivo as ImageMetadata | undefined });
const paises = sitio.paises.map((c) => ({ codigo: c, nombre: PAISES[c][lang] }));
---
<Base titulo={t(lang, 'nosotros')} descripcion={pagina.descripcion} lang={lang} alterno={alterno}>
  <section class="cabecera" aria-labelledby="nosotros-h1">
    <div class="wrap cabecera-g">
      <h1 id="nosotros-h1" class="aparece">{lema}</h1>
      {/* El primer párrafo es el LCP: sin animación de entrada (Aparece parte de opacidad 0 y lo retrasa). */}
      <div class="cabecera-txt">
        {pagina.quienes?.map((q, i) => <p class:list={i === 0 ? 'lead-1' : 'aparece lead-2'} style={`--i:${i + 1}`}>{q}</p>)}
      </div>
    </div>
  </section>

  <Tira lang={lang} hitos={lineaTiempo} />

  {pagina.mision && pagina.vision && (
    <MisionVision titulo={t(lang, 'secMision')} tituloVision={t(lang, 'secVision')} altFoto={t(lang, 'altEquipo')}
      mision={pagina.mision} vision={pagina.vision} foto={pagina.foto as ImageMetadata | undefined} indicadores={pagina.indicadores ?? []} />
  )}
  {!!pagina.valores?.length && <Valores titulo={t(lang, 'secValores')} valores={pagina.valores} />}
  {pagina.presencia && <Presencia titulo={t(lang, 'secPresencia')} presencia={pagina.presencia} paises={paises} />}
</Base>

<style>
  .cabecera { background: var(--bg); padding-block: var(--s7) var(--s6); border-bottom: var(--border) solid var(--line); }
  .cabecera-g { display: grid; gap: var(--s5); align-items: end; }
  @media (min-width: 900px) { .cabecera-g { grid-template-columns: 7fr 5fr; gap: var(--s6); } }
  .cabecera h1 {
    margin: 0; font-family: var(--f-titulo); font-weight: var(--fw-display); font-size: var(--fs-h1);
    line-height: var(--lh-display); letter-spacing: var(--ls-display); text-wrap: balance; color: var(--accent);
  }
  .cabecera h1::before { content: ''; display: block; width: 64px; height: 6px; margin-bottom: var(--s4); background: var(--hl-naranja); }
  .lead-1 { margin: 0; font-size: var(--fs-lead); line-height: 1.6; max-width: 52ch; }
  .lead-2 { margin: var(--s3) 0 0; color: var(--muted); max-width: 52ch; }
</style>
