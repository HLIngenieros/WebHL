---
// Ficha 3.1 (acta GHL-WEB-001; especificación v2.0 §5): a) datos generales, b) fotos, c) cantidades de obra.
// Es página propia (enlace directo, sin JS y buscadores) y, desde el explorador, el panel que sube
// (Explorador.tsx toma este <article>). Lo que falta no se muestra: queda en /pendientes/.
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Encabezado from '../components/ui/Encabezado.astro';
import Rotulo from '../components/ui/Rotulo.astro';
import Cifras from '../components/ui/Cifras.astro';
import Foto from '../components/ui/Foto.astro';
import Pod from '../components/Pod.astro';
import Lamina from '../components/Lamina';
import { cargar, codigos, imagen, lugarDe } from '../lib/datos';
import { bloque, medida, periodo, txt, type Entrada, type Proyecto } from '../lib/contenido';
import { escribirFiltros } from '../lib/explorador';
import { ruta, urlDe, type Lang } from '../i18n/rutas';
import { t } from '../i18n/ui';

interface Props { id: string; lang: Lang; alterno: string }
const { id, lang, alterno } = Astro.props;
const { datos } = await cargar();
const proyectos = datos.proyectos as unknown as Entrada<Proyecto>[];
const p = proyectos.find((x) => x.id === id)!.data;
const tx = bloque(p, lang);
const codigo = (await codigos()).get(id)!;
const anios = periodo(p);

// El sector ya no tiene página (Plan R, R-6): lleva al explorador filtrado.
const sector = datos.sectores.find((x) => x.id === p.sector.id)!.data;
const nombreSector = bloque(sector, lang).nombre;
const especialidades = p.servicios.map((s) => {
  const e = datos.servicios.find((x) => x.id === s.id)!.data;
  return { texto: bloque(e, lang).nombre, href: urlDe('servicios', e.slug, lang) };
});

const celdas = [
  { etiqueta: t(lang, 'cliente'), valor: p.cliente },
  { etiqueta: t(lang, 'duenoFinal'), valor: p.duenoFinal && p.duenoFinal !== p.cliente ? p.duenoFinal : undefined },
  { etiqueta: t(lang, 'rol'), valor: p.rol ? [t(lang, p.rol.tipo), p.rol.nombre].filter(Boolean).join(' · ') : undefined },
  { etiqueta: t(lang, 'ubicacion'), valor: lugarDe(p, lang) },
  { etiqueta: t(lang, 'periodo'), valor: anios },
  { etiqueta: t(lang, 'duracion'), valor: p.meses ? medida(p.meses, 'meses', lang) : undefined },
  { etiqueta: t(lang, 'sector'), enlaces: [{ texto: nombreSector, href: ruta('proyectos', lang) + escribirFiltros({ sector: sector.slug[lang] }) }] },
  { etiqueta: t(lang, 'especialidades'), enlaces: especialidades.length ? especialidades : undefined },
].filter((c) => c.valor || c.enlaces);

const cantidades = p.cantidades.map((c) => ({ valor: c.valor !== undefined ? medida(c.valor, c.unidad, lang) : '—', etiqueta: txt(c.concepto, lang)! }));
const pieDe = (f: Proyecto['fotos'][number]) => txt(f.pie, lang) ?? [tx.titulo, anios].filter(Boolean).join(' · ');
const [principal, ...galeria] = p.fotos;
const portada = principal ? await imagen(principal.archivo as ImageMetadata, pieDe(principal)) : undefined;
const pasos = [true, galeria.length > 0, cantidades.length > 0];
const letra = (i: number) => String(pasos.slice(0, i + 1).filter(Boolean).length);
---
<Base titulo={tx.titulo} descripcion={tx.resumen} lang={lang} alterno={alterno}>
  <article class="ficha pila" data-ficha={id}>
    <header class="wrap ficha-cab">
      <nav class="migas voz-datos" aria-label={t(lang, 'navegacion')}>
        <a href={ruta('proyectos', lang)}>{t(lang, 'proyectos')}</a><span aria-hidden="true"> / </span><span>{codigo}</span>
      </nav>
      <div class="ficha-cab-rejilla">
        <Encabezado nivel={1} titulo={tx.titulo} entrada={tx.resumen} medida={anios}>
          <Pod slot="pod" forma="rotulo" codigo={codigo} nombre={nombreSector} />
        </Encabezado>
        <div class="ficha-portada con-lamina">
          <Lamina imagen={portada} sector={p.sector.id} prioridad sizes="(min-width: 1600px) 640px, (min-width: 900px) 42vw, 100vw" titulo={`${tx.titulo} · ${nombreSector}`} />
        </div>
      </div>
    </header>

    <div class="wrap ficha-cuerpo pila">
      <section class="con-eje pila" aria-labelledby={`${id}-datos`}>
        <Pod forma="eje" letra={letra(0)} nombre={t(lang, 'datosGenerales')} />
        <h2 class="sr-only" id={`${id}-datos`}>{t(lang, 'datosGenerales')}</h2>
        <Rotulo celdas={celdas} />
        <p class="descripcion">{tx.descripcion}</p>
      </section>

      {galeria.length > 0 && (
        <section class="con-eje pila" aria-labelledby={`${id}-fotos`}>
          <Pod forma="eje" letra={letra(1)} nombre={t(lang, 'galeria')} dato={String(galeria.length)} />
          <h2 class="sr-only" id={`${id}-fotos`}>{t(lang, 'galeria')}</h2>
          <div class="hoja">
            {galeria.map((f, i) => (
              <figure>
                <button type="button" popovertarget={`${id}-foto-${i + 2}`} aria-label={`${t(lang, 'verFoto').replace('{n}', String(i + 2))}: ${pieDe(f)}`}>
                  <Foto src={f.archivo as ImageMetadata} alt="" sizes="(min-width: 1100px) 260px, (min-width: 640px) 30vw, 45vw" />
                </button>
                <figcaption class="voz-datos"><span class="num">{String(i + 2).padStart(2, '0')}</span> {pieDe(f)}</figcaption>
              </figure>
            ))}
          </div>
          {galeria.map((f, i) => (
            <div popover id={`${id}-foto-${i + 2}`} class="visor">
              <figure>
                <Foto src={f.archivo as ImageMetadata} alt={pieDe(f)} sizes="(min-width: 860px) 800px, 92vw" />
                <figcaption class="voz-datos">{String(i + 2).padStart(2, '0')} · {pieDe(f)}</figcaption>
              </figure>
              <button type="button" class="cerrar voz-datos" popovertarget={`${id}-foto-${i + 2}`} popovertargetaction="hide">{t(lang, 'cerrar')}</button>
            </div>
          ))}
        </section>
      )}

      {cantidades.length > 0 && (
        <section class="con-eje pila" aria-labelledby={`${id}-cantidades`}>
          <Pod forma="eje" letra={letra(2)} nombre={t(lang, 'cantidades')} dato={String(cantidades.length)} />
          <h2 class="sr-only" id={`${id}-cantidades`}>{t(lang, 'cantidades')}</h2>
          <Cifras items={cantidades} />
        </section>
      )}
    </div>
  </article>
</Base>

<style>
  .ficha { --pila: var(--s7); padding-block: var(--s5) var(--s7); }
  .migas { color: var(--muted); margin-bottom: var(--s4); }
  .migas a { color: var(--accent); }
  .ficha-cab-rejilla { display: grid; gap: var(--s5); align-items: center; }
  .ficha-portada :global(.lamina) { width: 100%; }
  @media (min-width: 900px) {
    .ficha-cab-rejilla { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  .ficha-cuerpo { --pila: var(--s6); }
  /* Bajo el pliegue: el navegador no lo maqueta hasta que se acerca (menos trabajo antes del LCP) */
  .ficha-cuerpo > section + section { content-visibility: auto; contain-intrinsic-size: auto 600px; }
  .con-eje { --pila: var(--s5); }
  .descripcion { margin: var(--s4) 0 0; max-width: 72ch; }
  .hoja { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s4); max-width: 1100px; }
  @media (min-width: 640px) { .hoja { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .hoja { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .hoja figure { position: relative; margin: 0; padding: var(--s2); border: var(--border) solid var(--line); background: var(--bg); display: grid; gap: var(--s2); }
  /* Marcas de corte en dos esquinas (guía §8) */
  .hoja figure::before, .hoja figure::after { content: ''; position: absolute; width: 10px; height: 10px; border: 0 solid var(--ink); }
  .hoja figure::before { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .hoja figure::after { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }
  .hoja button { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; aspect-ratio: 4 / 5; overflow: hidden; }
  .hoja button :global(img) { height: 100%; object-fit: cover; transition: transform calc(var(--t-rapido) * 3) var(--ease-izaje); }
  .hoja button:hover :global(img) { transform: scale(1.05); }
  .hoja figcaption { color: var(--muted); }
  .hoja .num { color: var(--accent); }
  .visor { padding: var(--s3); border: var(--border-strong) solid var(--ink); background: var(--paper); color: var(--ink); width: min(800px, 92vw); max-height: 92vh; overflow: auto; box-sizing: border-box; }
  .visor::backdrop { background: color-mix(in srgb, var(--ink) 70%, transparent); }
  .visor figure { margin: 0; display: grid; gap: var(--s2); }
  .visor figcaption { color: var(--muted); }
  .visor .cerrar { margin-top: var(--s3); min-height: 44px; padding: 0 var(--s3); background: none; border: var(--border) solid var(--line); color: var(--ink); cursor: pointer; font-family: inherit; }
</style>
