---
// Home (acta GHL-WEB-001 §1, especificación v2.0 §5, maqueta R0): video de fondo con el lema, cifras
// relevantes y clientes. Nada más.
import Base from '../layouts/Base.astro';
import Hero from '../components/inicio/Hero.astro';
import CifrasInicio from '../components/inicio/CifrasInicio.astro';
import Clientes from '../components/inicio/Clientes.astro';
import { cifrasInicio } from '../lib/inicio';
import { cargar } from '../lib/datos';
import { bloque, txt } from '../lib/contenido';
import type { Lang } from '../i18n/rutas';

interface Props { lang: Lang; alterno: string }
const { lang, alterno } = Astro.props;
const { datos } = await cargar();
const sitio = datos.sitio[0].data;
const lema = txt(sitio.lema, lang)!;
// Horas hombre: el proyecto visible con más horas (hoy, Columbus).
const mayor = datos.proyectos
  .filter((p) => p.data.visibilidad !== 'discreta' && p.data.hh)
  .sort((a, b) => b.data.hh! - a.data.hh!)[0];
// Seguridad: el primer indicador con signo de la página HSE (−64 % de frecuencia de accidentes).
const hse = datos.paginas.find((p) => p.data.pagina === 'hse' && p.data.lang === lang) ?? datos.paginas.find((p) => p.data.pagina === 'hse')!;
const seguridad = hse.data.indicadores!.find((x) => x.signo)!;
const cifras = cifrasInicio({
  fundacion: sitio.fundacion,
  paises: sitio.paises,
  proyecto: { nombre: bloque(mayor.data, lang).titulo, hh: mayor.data.hh! },
  seguridad: { valor: seguridad.valor, signo: seguridad.signo },
}, lang);
---
<Base titulo="Grupo HL" descripcion={lema} lang={lang} alterno={alterno} barra="inmersa">
  <Hero lang={lang} lema={lema} video={sitio.video} />
  <CifrasInicio lang={lang} cifras={cifras} />
  <Clientes lang={lang} />
</Base>
