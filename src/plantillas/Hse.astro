---
// Gestión integral (acta GHL-WEB-001, plan R5): cabecera con índice y los 6 bloques del acta en su orden:
// certificados, indicadores de seguridad, política SGI en 3D, Reglas de Oro, PIENSA® y herramientas tecnológicas.
// Todo el texto está en el HTML: sin JS o con movimiento reducido se lee completo y quieto.
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Indicadores from '../components/hse/Indicadores.astro';
import Politica from '../components/hse/Politica.astro';
import Reglas from '../components/hse/Reglas.astro';
import { cargar } from '../lib/datos';
import { txt } from '../lib/contenido';
import { ruta, type Lang } from '../i18n/rutas';
import { t } from '../i18n/ui';

interface Props { lang: Lang; alterno: string }
const { lang, alterno } = Astro.props;
const { datos } = await cargar();
const pagina = (datos.paginas.find((p) => p.data.pagina === 'hse' && p.data.lang === lang)
  ?? datos.paginas.find((p) => p.data.pagina === 'hse' && p.data.lang === 'es'))!.data;
const indicadores = (pagina.indicadores ?? []).filter((x) => !x.donde || x.donde.includes('hse'));
const AMBITO: Record<string, 'hseCalidad' | 'hseAmbiente' | 'hseSeguridad'> = { 'iso-9001': 'hseCalidad', 'iso-14001': 'hseAmbiente', 'iso-45001': 'hseSeguridad' };
// ISO en orden (9001, 14001, 45001) y luego las demás.
const numeroIso = (id: string) => (id.startsWith('iso') ? Number(id.replace(/\D/g, '')) : Infinity);
const certs = [...datos.certificaciones].sort((a, b) => numeroIso(a.id) - numeroIso(b.id))
  .map((c) => ({ id: c.id, norma: txt(c.data.norma, lang)!, ente: c.data.ente, codigo: c.data.codigo, sello: c.data.sello, iso: c.id.startsWith('iso'), ambito: AMBITO[c.id] }));
// Índice de la cabecera: los 6 bloques del acta, con el id de su título.
const INDICE: [string, string][] = [
  ['cert-titulo', t(lang, 'hseCert1')], ['ind-titulo', t(lang, 'hseIndicadores1')], ['pol-titulo', t(lang, 'hsePolitica1')],
  ['reglas-titulo', `${t(lang, 'hseReglas1')} ${t(lang, 'hseReglas2')}`], ['piensa-titulo', 'PIENSA®'], ['herr-titulo', t(lang, 'hseHerramientas1')],
];
const modulos = (pagina.herramientas ?? []).filter((h) => !h.transversal);
const base = (pagina.herramientas ?? []).find((h) => h.transversal);
const ANILLOS = [
  { norma: 'ISO 9001', ambito: t(lang, 'hseCalidad'), cx: 190, cy: 180, tx: 112, ty: 140 },
  { norma: 'ISO 14001', ambito: t(lang, 'hseAmbiente'), cx: 330, cy: 180, tx: 330, ty: 140 },
  { norma: 'ISO 45001', ambito: t(lang, 'hseSeguridad'), cx: 260, cy: 300, tx: 260, ty: 370, centro: true },
];
---
<Base titulo={pagina.titulo} descripcion={pagina.descripcion} lang={lang} alterno={alterno}>
  <!-- Cabecera: título, entrada e índice de los 6 bloques -->
  <section class="wrap cabecera" aria-labelledby="hse-h1">
    <div class="cab-txt">
      <h1 id="hse-h1"><span class="l"><span>{t(lang, 'hseInicio1')}</span></span> <span class="l"><span>{t(lang, 'hseInicio2')}</span></span></h1>
      <p class="lead aparece" style="--i:3">{pagina.descripcion}</p>
      <nav class="indice" aria-label={t(lang, 'hseIndice')}>
        <ol>
          {INDICE.map(([id, nombre], i) => (
            <li class="aparece" style={`--i:${i + 4}`}><a href={`#${id}`}><span class="voz-datos">0{i + 1}</span>{nombre}</a></li>
          ))}
        </ol>
      </nav>
    </div>
    {/* Tres normas, un sistema (maqueta ajustes-13nov, 3A): los anillos se trazan y se cruzan en el núcleo. */}
    <svg class="anillos" viewBox="0 0 520 470" role="img" aria-label={ANILLOS.map((a) => `${a.norma} (${a.ambito})`).join(', ') + ` · ${t(lang, 'hseSgi')}`}>
      <defs>
        <clipPath id="anillo-a"><circle cx="190" cy="180" r="130" /></clipPath>
        <clipPath id="anillo-b"><circle cx="330" cy="180" r="130" /></clipPath>
      </defs>
      {ANILLOS.map((a, i) => <circle class="aro" cx={a.cx} cy={a.cy} r="130" pathLength="1" style={`--i:${i}`} />)}
      <g clip-path="url(#anillo-a)"><g clip-path="url(#anillo-b)"><circle class="nucleo" cx="260" cy="300" r="130" /></g></g>
      {ANILLOS.map((a, i) => (
        <g class="et" style={`--i:${i}`}>
          <text x={a.tx} y={a.ty} class="et-norma" text-anchor={a.centro ? 'middle' : 'start'}>{a.norma}</text>
          <text x={a.tx} y={a.ty + 22} class="et-ambito" text-anchor={a.centro ? 'middle' : 'start'}>{a.ambito}</text>
        </g>
      ))}
      <text x="260" y="232" class="et-sgi" text-anchor="middle">{lang === 'es' ? 'SGI' : 'IMS'}</text>
    </svg>
  </section>

  <!-- 1 · Certificados -->
  <section class="certificaciones" aria-labelledby="cert-titulo">
    <div class="wrap">
      <div class="cab">
        <h2 id="cert-titulo" class="tit h2-barra">{t(lang, 'hseCert1')} <span>{t(lang, 'hseCert2')}</span></h2>
        <span class="voz-datos">{t(lang, 'hseSgi')}</span>
      </div>
      <ul class="certs revela">
        {certs.map((c, i) => (
          <li class:list={['cert', { dudosa: !c.iso }]} style={`--i:${i}`}>
            <span class="c1 voz-datos"><span>C-0{i + 1}</span><span>{c.ambito ? t(lang, c.ambito) : t(lang, 'certPorConfirmar')}</span></span>
            <span class="norma">{c.norma}</span>
            <span class="ente">{c.ente}</span>
            {c.sello && <Image class="sello" src={c.sello} width={160} alt={`${t(lang, 'sello')} ${c.ente} ${c.norma}`} />}
            {c.codigo && <span class="c3 voz-datos"><span>{c.codigo}</span></span>}
          </li>
        ))}
      </ul>
      <a class="cert-docs" href={`${ruta('documentos', lang)}#certificaciones`}>{t(lang, 'hseCertDocs')} <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <!-- 2 · Indicadores de seguridad · 3 · Política SGI · 4 · Reglas de Oro -->
  {indicadores.length > 0 && <Indicadores lang={lang} indicadores={indicadores} />}
  {pagina.politica && <Politica lang={lang} politica={pagina.politica} />}
  {pagina.reglas && <Reglas lang={lang} reglas={pagina.reglas} />}

  <!-- 5 · PIENSA® -->
  {pagina.piensa && (
    <section class="piensa" aria-labelledby="piensa-titulo">
      <div class="wrap piensa-g">
        <div>
          <h2 id="piensa-titulo" class="tit h2-barra piensa-tit">PIENSA<sup>®</sup></h2>
          <p class="lead">{pagina.piensa.texto}</p>
        </div>
        <div>
          <ol class="eje revela">
            {pagina.piensa.pasos.map((p, i) => (
              <li style={`--i:${i}`}><span class="bur">{i + 1}</span><h3>{p.titulo}</h3><p>{p.texto}</p></li>
            ))}
          </ol>
          <p class="persona"><svg class="pic" viewBox="0 0 40 40" aria-hidden="true"><path d="M14 12a6 6 0 1 0 12 0a6 6 0 1 0 -12 0M8 36c0-7 5-12 12-12s12 5 12 12" /></svg><span>{t(lang, 'hsePersona')}</span></p>
        </div>
      </div>
    </section>
  )}

  <!-- 6 · Herramientas tecnológicas de gestión -->
  {pagina.herramientas && (
    <section class="herramientas" aria-labelledby="herr-titulo">
      <div class="wrap">
        <div class="cab"><h2 id="herr-titulo" class="tit h2-barra">{t(lang, 'hseHerramientas1')} <span>{t(lang, 'hseHerramientas2')}</span></h2></div>
        {/* Diagrama (maqueta ajustes-13nov, 5): módulos arriba, conectores con pulso y la base transversal debajo. */}
        <div class="diag revela">
          <ul class="mods">
            {modulos.map((h, i) => (
              <li class="mod" style={`--i:${i}`}>
                <span class="voz-datos cat">0{i + 1} · {h.categoria}</span>
                <h3 class="logo">{h.logo ? <img src={h.logo} alt={h.nombre} height="32" loading="lazy" /> : h.nombre}</h3>
                <p>{h.uso}</p>
              </li>
            ))}
          </ul>
          {base && (
            <>
              <div class="con" aria-hidden="true" style={`--n:${modulos.length}`}>{modulos.map((_, i) => <i style={`--i:${i}`} />)}</div>
              <div class="base">
                <h3 class="logo">{base.logo ? <img src={base.logo} alt={base.nombre} height="32" loading="lazy" /> : base.nombre}</h3>
                <p><span class="voz-datos">{t(lang, 'hseTransversal')} · {base.categoria}</span>{base.uso}</p>
                {base.apps && <ul class="apps">{base.apps.map((a) => <li class="voz-datos">{a}</li>)}</ul>}
              </div>
            </>
          )}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // Certificaciones: se inclinan con el cursor.
  function iniciar() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('.cert:not([data-listo])').forEach((c) => {
      c.dataset.listo = '1';
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        c.style.transform = `perspective(900px) rotateY(${(x - 0.5) * 14}deg) rotateX(${(0.5 - y) * 12}deg)`;
        c.style.setProperty('--mx', `${x * 100}%`); c.style.setProperty('--my', `${y * 100}%`);
      });
      c.addEventListener('pointerleave', () => { c.style.transform = ''; });
    });
  }
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .tit { margin: 0; }
  .tit span { display: block; font-weight: var(--fw-fina); }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--s3); margin-bottom: var(--s5); }
  .cab > .voz-datos { color: var(--muted); }

  /* Cabecera */
  .cabecera { display: grid; gap: var(--s5); align-items: center; padding-block: var(--s6); }
  .cab-txt { display: grid; gap: var(--s4); justify-items: start; }
  @media (min-width: 900px) { .cabecera { grid-template-columns: 7fr 5fr; gap: var(--s6); } }
  /* Anillos ISO: se trazan uno tras otro, luego aparecen las etiquetas y el núcleo late. */
  .anillos { width: 100%; max-width: 480px; justify-self: center; overflow: visible; }
  .aro { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: 1; animation: aro var(--t-trazo) var(--ease-plano) forwards; animation-delay: calc(var(--i) * 250ms); }
  @keyframes aro { to { stroke-dashoffset: 0; } }
  .nucleo { fill: var(--hl-naranja); opacity: 0; transform-box: fill-box; transform-origin: center; animation: nucleo var(--t-aparece) ease 1.4s forwards, late 2.4s ease-in-out 2.2s infinite; }
  @keyframes nucleo { to { opacity: 1; } }
  @keyframes late { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
  .et { opacity: 0; animation: nucleo var(--t-aparece) ease forwards; animation-delay: calc(700ms + var(--i) * 200ms); }
  .et-norma { font-family: var(--f-titulo); font-weight: var(--fw-title); font-size: 17px; fill: var(--ink); } /* unidades del viewBox */
  .et-ambito { font-size: 15px; fill: var(--muted); } /* unidades del viewBox */
  .et-sgi { font-family: var(--f-titulo); font-weight: var(--fw-display); font-size: 20px; fill: var(--azul-900); opacity: 0; animation: nucleo var(--t-aparece) ease 1.7s forwards; } /* unidades del viewBox */
  h1 { margin: 0; max-width: 18ch; font-size: var(--fs-h1); line-height: var(--lh-display); }
  h1 .l { display: block; overflow: hidden; padding-bottom: .06em; }
  h1 .l > span { display: block; animation: linea var(--t-izaje) var(--ease-izaje) both; }
  h1 .l + .l > span { color: var(--accent); animation-delay: 120ms; }
  @keyframes linea { from { transform: translateY(105%); } }
  .lead { margin: 0; color: var(--muted); max-width: 60ch; }
  .indice ol { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: var(--s2) 0 0; padding: 0; }
  .indice a {
    display: inline-flex; align-items: center; gap: var(--s2); min-height: 44px; padding: 0 var(--s3); border-radius: var(--r-chip);
    border: var(--border) solid var(--line); color: var(--ink); text-decoration: none; font-weight: var(--fw-boton);
    transition: background-color var(--t-rapido) ease, color var(--t-rapido) ease, border-color var(--t-rapido) ease;
  }
  .indice a span { color: var(--accent); transition: color var(--t-rapido) ease; }
  .indice a:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .indice a:hover span { color: var(--accent-ink); }
  /* Al llegar por el índice, el título del bloque queda debajo de la barra fija. */
  :global(main h2[id]) { scroll-margin-top: calc(var(--bar-h) + var(--s4)); }

  /* 3 · Certificaciones */
  .certificaciones { padding-block: var(--s7); background: var(--bg); }
  .cert-docs { display: inline-flex; gap: var(--s2); margin-top: var(--s4); color: var(--accent); font-weight: var(--fw-boton); text-decoration: none; border-bottom: var(--border) solid currentColor; }
  .cert-docs:hover span { display: inline-block; transform: translateY(3px); transition: transform var(--t-rapido) var(--ease-izaje); }
  .certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s3); }
  .cert {
    position: relative; display: grid; grid-template-rows: auto auto 1fr auto; gap: var(--s2); padding: var(--s4); overflow: hidden;
    background: var(--paper); border: var(--border-strong) solid var(--ink); border-radius: var(--r-card); transition: transform var(--t-rapido) var(--ease-izaje);
  }
  .cert::after { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity var(--t-rapido) ease; background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%); }
  .cert:hover::after { opacity: 1; }
  .cert.dudosa { border-style: dashed; background: transparent; }
  .c1, .c3 { display: flex; justify-content: space-between; gap: var(--s2); color: var(--accent); }
  .c3 { color: var(--muted); border-top: var(--border) dashed var(--line); padding-top: var(--s2); }
  .norma { font-family: var(--f-titulo); font-weight: var(--fw-display); font-size: var(--fs-h3); line-height: var(--lh-title); white-space: nowrap; }
  .dudosa .norma { font-size: var(--fs-lead); white-space: normal; }
  .ente { color: var(--muted); font-size: var(--fs-sm); }
  .sello { height: 80px; width: auto; max-width: none; justify-self: start; align-self: end; padding: var(--s1); background: var(--hl-blanco); transition: transform var(--t-aparece) var(--ease-izaje); }
  .cert:hover .sello { transform: rotate(8deg) scale(1.06); }
  :global(html.js) .certs:not(:global(.visible)) .cert { opacity: 0; transform: translateY(28px); }
  :global(html.js) .certs .cert { transition: opacity var(--t-izaje) var(--ease-izaje), transform var(--t-izaje) var(--ease-izaje); transition-delay: calc(var(--i) * 90ms); }
  :global(html.js) .certs:not(:global(.visible)) .sello { transform: rotate(-25deg) scale(.6); opacity: 0; }
  :global(html.js) .certs .sello { transition: transform var(--t-trazo) var(--ease-izaje), opacity var(--t-aparece) ease; transition-delay: calc(250ms + var(--i) * 120ms); }
  :global(html.js) .certs:global(.visible) .cert:hover .sello { transition-delay: 0s; }
  :global(html.sin-revela) .certs .cert, :global(html.sin-revela) .certs .sello { opacity: 1; transform: none; }
  @media (min-width: 900px) { .certs { grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, .8fr); } }

  /* 6 · PIENSA® */
  .piensa { padding-block: var(--s7); background: var(--bg); border-top: var(--border) solid var(--line); }
  .piensa-g { display: grid; gap: var(--s5); align-items: center; }
  .piensa-g > div:first-child { display: grid; gap: var(--s3); justify-items: start; }
  .piensa-tit sup { color: var(--accent); font-size: var(--fs-lead); vertical-align: top; }
  .eje { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); }
  .eje::before { content: ''; position: absolute; left: 21px; right: 21px; top: 21px; height: 1.5px; background: var(--accent); transform-origin: left; }
  .eje .bur { position: relative; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; margin-bottom: var(--s3); background: var(--bg); color: var(--accent); border: var(--border-strong) solid var(--accent); font-weight: var(--fw-title); transition: background-color var(--t-rapido) ease, color var(--t-rapido) ease, transform var(--t-aparece) var(--ease-izaje); }
  .eje li:hover .bur { background: var(--accent); color: var(--accent-ink); transform: scale(1.12); }
  .eje h3 { margin: 0 0 var(--s1); font-size: var(--fs-lead); }
  .eje p { margin: 0; color: var(--muted); font-size: var(--fs-sm); }
  :global(html.js) .eje::before { transition: transform var(--t-trazo) var(--ease-plano); }
  :global(html.js) .eje:not(:global(.visible))::before { transform: scaleX(0); }
  .persona { display: flex; align-items: center; gap: var(--s3); margin: var(--s4) 0 0; padding: var(--s3) var(--s4); border: var(--border-strong) solid var(--ink); border-radius: var(--r-card); background: var(--paper); }
  .persona .pic { width: 40px; height: 40px; flex: none; color: var(--accent); }
  .pic path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 900px) { .piensa-g { grid-template-columns: 5fr 7fr; gap: var(--s6); } }

  /* 6 · Herramientas */
  .herramientas { padding-block: var(--s7); background: var(--paper); }
  .mods { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .mods { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .mod {
    position: relative; display: grid; gap: var(--s2); align-content: start; padding: var(--s4); overflow: hidden;
    background: var(--bg); border: var(--border) solid var(--line); border-radius: var(--r-card);
  }
  /* Línea naranja que se traza al pasar: el módulo "se conecta". */
  .mod::before { content: ''; position: absolute; left: 0; top: 0; height: 3px; width: 100%; background: var(--hl-naranja); transform: scaleX(0); transform-origin: left; transition: transform var(--t-aparece) var(--ease-plano); }
  .mod:hover::before { transform: scaleX(1); }
  .cat { color: var(--accent); }
  /* Casilla del logo: mientras no haya SVG aprobado, el nombre hace de logotipo. */
  .logo {
    display: grid; place-items: center; min-height: 56px; margin: 0; padding: var(--s1) var(--s2); border: var(--border) dashed var(--line);
    border-radius: var(--r-card); font-size: var(--fs-h3); line-height: var(--lh-title); text-align: center;
  }
  .logo img { height: 32px; width: auto; }
  .mod p { margin: 0; color: var(--muted); font-size: var(--fs-sm); }
  /* Conectores: una guía punteada por módulo y un pulso que sube desde la base (solo escritorio). */
  .con { display: none; }
  @media (min-width: 900px) {
    .con { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--s3); height: var(--s6); }
    .con i { position: relative; justify-self: center; width: 2px; background: repeating-linear-gradient(180deg, var(--azul-200) 0 6px, transparent 6px 10px); }
    .con i::after { content: ''; position: absolute; left: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--hl-naranja); animation: pulso 2.2s ease-in-out infinite; animation-delay: calc(var(--i) * 400ms); }
  }
  @keyframes pulso { 0% { top: 100%; opacity: 0; } 15%, 85% { opacity: 1; } 100% { top: -8px; opacity: 0; } }
  .base {
    display: grid; gap: var(--s3) var(--s5); align-items: center; margin-top: var(--s3); padding: var(--s4) var(--s5);
    background: var(--azul-900); color: var(--hl-blanco); border-radius: var(--r-card);
  }
  @media (min-width: 900px) { .base { grid-template-columns: 220px 1fr auto; margin-top: 0; } }
  .base .logo { border-color: color-mix(in srgb, var(--hl-trazo) 45%, transparent); color: var(--hl-blanco); }
  .base p { margin: 0; color: var(--azul-50); font-size: var(--fs-sm); }
  .base p .voz-datos { display: block; margin-bottom: var(--s1); color: var(--hl-naranja); }
  .apps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .apps li { padding: 2px var(--s2); border: var(--border) solid color-mix(in srgb, var(--hl-trazo) 45%, transparent); color: var(--hl-trazo); }
  :global(html.js) .mod, :global(html.js) .base { transition: opacity var(--t-izaje) var(--ease-izaje), transform var(--t-izaje) var(--ease-izaje), box-shadow var(--t-rapido) ease; transition-delay: calc(var(--i, 4) * 80ms); }
  :global(html.js) .diag:not(:global(.visible)) :is(.mod, .base) { opacity: 0; transform: translateY(28px); }
  @media (hover: hover) { :global(html.js) .diag:global(.visible) .mod:hover { transform: translateY(-4px); box-shadow: var(--sombra-card); transition-delay: 0s; } }
