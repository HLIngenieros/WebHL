---
// Especialidad (acta GHL-WEB-001; especificación v2.0 §5): nombre, resumen y sus 3 proyectos, que llevan a
// su ficha; debajo, el enlace al explorador filtrado por la especialidad. Las tarjetas entran en cascada.
import Base from '../layouts/Base.astro';
import Encabezado from '../components/ui/Encabezado.astro';
import Pod from '../components/Pod.astro';
import Tarjeta from '../components/Tarjeta';
import { cargar, tarjetas } from '../lib/datos';
import { bloque, proyectosDe, type Entrada, type Proyecto } from '../lib/contenido';
import { RUTAS, type Lang } from '../i18n/rutas';
import { escribirFiltros } from '../lib/explorador';
import { t } from '../i18n/ui';

interface Props { id: string; lang: Lang; alterno: string }
const { id, lang, alterno } = Astro.props;
const { datos } = await cargar();
const proyectos = datos.proyectos as unknown as Entrada<Proyecto>[];
const s = datos.servicios.find((x) => x.id === id)!.data;
const tx = bloque(s, lang);
const codigo = `E-${String(s.orden).padStart(2, '0')}`;
const muestra = await tarjetas(proyectosDe(s, proyectos), lang);
// El explorador también lista las discretas (D6): el enlace cuenta lo que allí se verá.
const enExplorador = proyectos.filter((p) => p.data.servicios.some((x) => x.id === id)).length;
---
<Base titulo={tx.nombre} descripcion={tx.resumen} lang={lang} alterno={alterno}>
  <div class="wrap servicio pila">
    <Encabezado nivel={1} titulo={tx.nombre} entrada={tx.resumen}>
      <Pod slot="pod" forma="rotulo" codigo={codigo} nombre={t(lang, 'servicios')} />
    </Encabezado>

    <section class="suyos" aria-labelledby="s-proyectos">
      <h2 id="s-proyectos" class="h2-barra">{t(lang, 'proyectosServicio')}</h2>
      <div class="tarjetas-cont"><div class="tarjetas">{muestra.map((x) => <Tarjeta t={x} lang={lang} />)}</div></div>
      {enExplorador > muestra.length && (
        <a class="ver-todos" href={RUTAS.proyectos[lang] + escribirFiltros({ servicio: s.slug[lang] })}>
          {t(lang, 'verTodos').replace('{n}', String(enExplorador))} <span aria-hidden="true">→</span>
        </a>
      )}
    </section>
  </div>
</Base>

<style>
  .servicio { --pila: var(--s6); padding-block: var(--s5) var(--s7); }
  .suyos { display: grid; gap: var(--s5); }
  .ver-todos { justify-self: start; color: var(--accent); font-family: var(--f-titulo); font-weight: var(--fw-strong); text-decoration: none; }
  .ver-todos span { display: inline-block; transition: transform var(--t-rapido) var(--ease-izaje); }
  .ver-todos:hover span { transform: translateX(5px); }
  /* Cascada al entrar (guía §8) */
  .suyos :global(.tarjeta) { animation: sube var(--t-izaje) var(--ease-izaje) both; }
  .suyos :global(.tarjeta:nth-child(2)) { animation-delay: calc(var(--t-escalon) * 1.5); }
  .suyos :global(.tarjeta:nth-child(3)) { animation-delay: calc(var(--t-escalon) * 3); }
  @keyframes sube { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .suyos :global(.tarjeta) { animation: none; } }
</style>
