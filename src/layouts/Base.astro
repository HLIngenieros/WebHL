---
import '../styles/global.css';
import Barra from '../components/Barra.astro';
import Pie from '../components/Pie.astro';
import Contacto from '../components/Contacto.astro';
import { ClientRouter } from 'astro:transitions';
import { parExacto, seccionDe, type Lang } from '../i18n/rutas';
import { t } from '../i18n/ui';

interface Props {
  titulo: string;
  descripcion?: string;
  lang: Lang;
  alterno?: string;
  noindex?: boolean;
  /** Acento de sección (guía §3.5); por defecto, el de la sección de la URL. */
  seccion?: string;
  /** Barra inmersa en el hero (solo el inicio, guía §7). */
  barra?: 'normal' | 'inmersa';
}

const { titulo, lang, alterno, noindex = false, barra = 'normal' } = Astro.props;
// Solo estas secciones tienen acento propio; el resto (inicio, nosotros, contacto, pie) usa el azul.
const CON_ACENTO = ['proyectos', 'servicios', 'sectores', 'hse', 'noticias'];
const deUrl = seccionDe(Astro.url.pathname);
const seccion = Astro.props.seccion ?? (deUrl && CON_ACENTO.includes(deUrl) ? deUrl : undefined);
const descripcion = Astro.props.descripcion ?? t(lang, 'descripcion');
const aqui = Astro.url.pathname;
// hreflang solo cuando existe la página equivalente; las páginas noindex no declaran canonical ni alternos.
const otra = alterno ?? parExacto(aqui);
const abs = (p: string) => new URL(p, Astro.site).href;
const [es, en] = lang === 'es' ? [aqui, otra] : [otra, aqui];
const alternos = !noindex && otra !== undefined;

// Transición de vista (guía §9): el contenido entra por barrido lateral; barra y contacto quedan quietos.
const fase = (name: string) => ({ name, duration: 'var(--t-vista)', easing: 'var(--ease-barrido)', fillMode: 'both' });
const barrido = {
  forwards: { old: fase('vista-sale'), new: fase('vista-entra') },
  backwards: { old: fase('vista-sale-atras'), new: fase('vista-entra-atras') },
};
---
<!doctype html>
<html lang={lang} data-seccion={seccion} class:list={[{ 'barra-inmersa': barra === 'inmersa' }]} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo === 'Grupo HL' ? titulo : `${titulo} · Grupo HL`}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={abs(aqui)} />}
    {alternos && <link rel="alternate" hreflang="es" href={abs(es!)} />}
    {alternos && <link rel="alternate" hreflang="en" href={abs(en!)} />}
    {alternos && <link rel="alternate" hreflang="x-default" href={abs(es!)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Antes de pintar: marca que hay JS y aplica el tema guardado (también tras cada cambio de página).
      (function () {
        function aplicar(d) {
          d.classList.add('js');
          if (document.documentElement.classList.contains('sin-revela')) d.classList.add('sin-revela');
          var t = window.__tema;
          try { t = localStorage.getItem('tema') || t; } catch (e) {}
          if (t === 'dark' || t === 'light') d.dataset.theme = t;
        }
        aplicar(document.documentElement);
        document.addEventListener('astro:before-swap', function (e) { aplicar(e.newDocument.documentElement); });
        setTimeout(function () { if (!window.__revela) document.documentElement.classList.add('sin-revela'); }, 2000);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t(lang, 'saltar')}</a>
    <Barra lang={lang} alterno={alterno} inmersa={barra === 'inmersa'} />
    <main id="contenido" transition:name="contenido" transition:animate={barrido}>
      <slot />
    </main>
    <Pie lang={lang} />
    <Contacto lang={lang} />
    <script>import '../scripts/revela.ts';</script>
  </body>
</html>
