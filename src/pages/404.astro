---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import mono from '../assets/marca/monograma-hl-calado.svg?raw';
// Momento de marca (guía §2.2): el monograma ocupa el lugar de una burbuja de eje.
const svg = mono.replace(/<!--[\s\S]*?-->\s*/, '').replace(' role="img" aria-label="HL"', ' aria-hidden="true" focusable="false"');
---
<Base titulo={t('es', 'noEncontrada')} lang="es" noindex>
  <section class="wrap py-s7">
    <div class="burbuja-marca" set:html={svg} />
    <h1>{t('es', 'noEncontrada')} <span lang="en" class="block text-muted">{t('en', 'noEncontrada')}</span></h1>
    <p class="mt-s5"><a href="/">{t('es', 'inicio')}</a> · <a href="/en/" lang="en">{t('en', 'inicio')}</a></p>
  </section>
</Base>

<style>
  /* Burbuja de eje (guía §6) con el monograma: el eje punteado baja hasta el título. */
  .burbuja-marca { position: relative; width: var(--s6); height: var(--s6); color: var(--accent); margin-bottom: var(--s6); }
  .burbuja-marca :global(svg) { display: block; width: 100%; height: 100%; }
  .burbuja-marca::after {
    content: ""; position: absolute; left: 50%; top: 100%; height: var(--s5);
    border-left: var(--border) dashed var(--accent);
  }
</style>
