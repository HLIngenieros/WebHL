---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---
<Base titulo={t('es', 'noEncontrada')} lang="es" noindex>
  <section class="wrap py-s7">
    <h1>{t('es', 'noEncontrada')} <span lang="en" class="block text-muted">{t('en', 'noEncontrada')}</span></h1>
    <p class="mt-s5"><a href="/">{t('es', 'inicio')}</a> · <a href="/en/" lang="en">{t('en', 'inicio')}</a></p>
  </section>
</Base>
