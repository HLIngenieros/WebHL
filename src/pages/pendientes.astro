---
// Pendientes de contenido (especificación §4): lo que falta para lanzar. Es la futura solicitud de insumos.
// La validación vive en src/lib/datos.ts (la usan todas las páginas de contenido). Se elimina en F6.
import Base from '../layouts/Base.astro';
import Encabezado from '../components/ui/Encabezado.astro';
import Tabla from '../components/ui/Tabla.astro';
import Chip from '../components/ui/Chip.astro';
import { cargar, type Pendiente } from '../lib/datos';

const nombres = ['proyectos', 'servicios', 'sectores', 'sedes', 'certificaciones', 'historia', 'testimonios', 'sitio', 'paginas'] as const;
const { datos, pendientes } = await cargar();

const grupos: { tipo: Pendiente['tipo']; titulo: string; entrada: string }[] = [
  { tipo: 'insumo', titulo: 'Insumos que debe aportar HL', entrada: 'Datos que no existen en el sitio actual ni en el PDF de ECOHL.' },
  { tipo: 'confirmar', titulo: 'Por confirmar o decidir', entrada: 'Dudas sobre datos existentes y decisiones abiertas.' },
  { tipo: 'traduccion', titulo: 'Traducción al inglés', entrada: 'Se resuelve en F5 sobre los textos en español ya cerrados.' },
  { tipo: 'aviso', titulo: 'Avisos', entrada: 'No impiden lanzar, salvo los marcados como bloqueantes.' },
];
const etiquetas: Record<(typeof nombres)[number], string> = {
  proyectos: 'Proyectos', servicios: 'Servicios', sectores: 'Sectores', sedes: 'Sedes', certificaciones: 'Certificaciones',
  historia: 'Historia', testimonios: 'Testimonios', sitio: 'Sitio', paginas: 'Páginas',
};
const titulo = (id: string) => datos.proyectos.find((p) => p.id === id)?.data.es.titulo ?? id;
const bloqueantes = pendientes.filter((x) => x.bloquea).length;
const proyectos = [...datos.proyectos].sort((a, b) => a.data.es.titulo.localeCompare(b.data.es.titulo, 'es'));

// Una fila por entrada, con todo lo que le falta: así se lee como solicitud de insumos.
function porEntrada(xs: Pendiente[]) {
  const filas = new Map<string, { coleccion: string; id: string; items: Pendiente[] }>();
  for (const x of xs) {
    const k = `${x.coleccion}/${x.id}`;
    if (!filas.has(k)) filas.set(k, { coleccion: x.coleccion, id: x.id, items: [] });
    filas.get(k)!.items.push(x);
  }
  const orden = (c: string) => nombres.indexOf(c as (typeof nombres)[number]);
  return [...filas.values()].sort((a, b) => orden(a.coleccion) - orden(b.coleccion) || nombre(a).localeCompare(nombre(b), 'es'));
}
const nombre = (f: { coleccion: string; id: string }) => (f.coleccion === 'proyectos' ? titulo(f.id) : f.id);
---
<Base titulo="Pendientes de contenido" lang="es" noindex>
  <div class="wrap pendientes">
    <Encabezado
      nivel={1}
      codigo="PND"
      titulo="Pendientes de contenido"
      entrada={`${bloqueantes} pendientes bloquean el lanzamiento y ${pendientes.length - bloqueantes} son avisos. Generado al compilar a partir de las colecciones.`}
    />

    <dl class="resumen">
      {nombres.map((n) => (
        <div data-conteo={n}><dt class="voz-datos">{etiquetas[n]}</dt><dd class="cifra">{datos[n].length}</dd></div>
      ))}
    </dl>

    {datos.proyectos.length > 0 && (
      <section>
        <Encabezado codigo="PND-0" titulo="Proyectos" />
        <Tabla titulo="Resumen de proyectos">
          <thead><tr><th>Proyecto</th><th>Sector</th><th>Fuente</th><th>Visibilidad</th><th class="num">Pendientes</th></tr></thead>
          <tbody>
            {proyectos.map((p) => (
              <tr data-proyecto={p.id} data-visibilidad={p.data.visibilidad} data-fuente={p.data.fuente}>
                <td>{p.data.es.titulo}</td><td>{p.data.sector.id}</td><td>{p.data.fuente}</td><td>{p.data.visibilidad}</td>
                <td class="num">{pendientes.filter((x) => x.coleccion === 'proyectos' && x.id === p.id).length}</td>
              </tr>
            ))}
          </tbody>
        </Tabla>
      </section>
    )}

    {grupos.map((g, i) => {
      const xs = pendientes.filter((x) => x.tipo === g.tipo);
      return xs.length > 0 && (
        <section data-grupo={g.tipo}>
          <Encabezado codigo={`PND-${i + 1}`} titulo={`${g.titulo} (${xs.length})`} entrada={g.entrada} />
          <Tabla titulo={g.titulo}>
            <thead><tr><th>Colección</th><th>Entrada</th><th>Qué falta</th><th>Estado</th></tr></thead>
            <tbody>
              {porEntrada(xs).map((f) => (
                <tr data-coleccion={f.coleccion} data-id={f.id}>
                  <td>{etiquetas[f.coleccion as (typeof nombres)[number]]}</td>
                  <td>{nombre(f)}</td>
                  <td>
                    <ul class="falta">
                      {f.items.map((x) => (
                        <li data-campo={x.campo}>
                          {x.tipo === 'confirmar' && x.detalle ? x.detalle : <>{x.campo}{x.detalle && <span class="detalle"> · {x.detalle}</span>}</>}
                        </li>
                      ))}
                    </ul>
                  </td>
                  <td>{f.items.some((x) => x.bloquea) ? <Chip tipo="crit">Bloquea</Chip> : <Chip tipo="med">Aviso</Chip>}</td>
                </tr>
              ))}
            </tbody>
          </Tabla>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .pendientes { display: grid; gap: var(--s6); padding-block: var(--s6); }
  .resumen { display: grid; grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); gap: var(--s3); margin: 0; }
  .falta { margin: 0; padding-left: 1.1em; }
  .falta li + li { margin-top: var(--s1); }
  .detalle { color: var(--muted); }
  td { vertical-align: top; }
  .resumen div { border-top: var(--border-strong) solid var(--ink); padding-top: var(--s2); }
  .resumen dt { color: var(--muted); }
  .resumen dd { margin: 0; font-size: var(--fs-h3); }
  section { display: grid; gap: var(--s4); }
  @media print {
    .pendientes { padding: 0; gap: var(--s4); }
    section { break-inside: avoid-page; }
  }
</style>
