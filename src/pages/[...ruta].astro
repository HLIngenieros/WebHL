---
// Enrutador único: páginas de contenido (proyectos, servicios, sectores) y provisionales del resto del
// mapa. Cada fase cambia una provisional por su plantilla.
import Base from '../layouts/Base.astro';
import { RUTAS, type ClaveRuta, type Lang } from '../i18n/rutas';
import { t } from '../i18n/ui';
import Nota from '../components/ui/Nota.astro';
import { rutasDeContenido, type PropsContenido } from '../lib/datos';
import Ficha from '../plantillas/Ficha.astro';
import Proyectos from '../plantillas/Proyectos.astro';
import Servicios from '../plantillas/Servicios.astro';
import Servicio from '../plantillas/Servicio.astro';
import Sectores from '../plantillas/Sectores.astro';
import Sector from '../plantillas/Sector.astro';
import Inicio from '../plantillas/Inicio.astro';
import Nosotros from '../plantillas/Nosotros.astro';

export async function getStaticPaths() {
  // getStaticPaths corre aislado del resto del archivo: sus constantes van aquí dentro.
  const CONTENIDO: ClaveRuta[] = ['proyectos', 'servicios', 'sectores'];
  const provisionales = (Object.keys(RUTAS) as ClaveRuta[])
    .filter((clave) => !CONTENIDO.includes(clave))
    .flatMap((clave) =>
      (['es', 'en'] as Lang[]).map((lang) => ({
        params: { ruta: RUTAS[clave][lang].replace(/^\/|\/$/g, '') || undefined },
        props: { clave, lang },
      })),
    );
  return [...provisionales, ...(await rutasDeContenido())];
}

type Props = { clave: ClaveRuta; lang: Lang } | PropsContenido;
const props = Astro.props as Props;
const { lang } = props;
// Las páginas de contenido llevan su título en su plantilla; aquí solo el de las provisionales.
const titulo = 'clave' in props ? (props.clave === 'inicio' ? 'HL Ingenieros' : t(lang, props.clave)) : '';
---
{'tipo' in props ? (
  props.tipo === 'ficha' ? <Ficha id={props.id!} lang={lang} alterno={props.alterno} />
  : props.tipo === 'proyectos' ? <Proyectos lang={lang} alterno={props.alterno} />
  : props.tipo === 'servicios' ? <Servicios lang={lang} alterno={props.alterno} />
  : props.tipo === 'servicio' ? <Servicio id={props.id!} lang={lang} alterno={props.alterno} />
  : props.tipo === 'sectores' ? <Sectores lang={lang} alterno={props.alterno} />
  : <Sector id={props.id!} lang={lang} alterno={props.alterno} />
) : props.clave === 'inicio' ? (
  <Inicio lang={lang} alterno={RUTAS.inicio[lang === 'es' ? 'en' : 'es']} />
) : props.clave === 'nosotros' ? (
  <Nosotros lang={lang} alterno={RUTAS.nosotros[lang === 'es' ? 'en' : 'es']} />
) : (
  <Base titulo={titulo} lang={lang}>
    <section class="wrap py-s7">
      <h1 class="aparece">{titulo}</h1>
      <div class="mt-s5 aparece" style="--i:1"><Nota>{t(lang, 'construccion')}</Nota></div>
    </section>
  </Base>
)}
