---
// Catálogo de componentes base (guía §7) con datos reales de Columbus. Solo para revisión: se elimina en F6.
import Base from '../layouts/Base.astro';
import Encabezado from '../components/ui/Encabezado.astro';
import Rotulo from '../components/ui/Rotulo.astro';
import Cifras from '../components/ui/Cifras.astro';
import Tabla from '../components/ui/Tabla.astro';
import Boton from '../components/ui/Boton.astro';
import Chip from '../components/ui/Chip.astro';
import Nota from '../components/ui/Nota.astro';
import Campo from '../components/ui/Campo.astro';
import Foto from '../components/ui/Foto.astro';
import columbus from '../assets/proyectos/planta-columbus/1.jpg';
import Pod from '../components/Pod.astro';
import Tarjeta from '../components/Tarjeta';
import Lamina from '../components/Lamina';
import Ilustracion, { SECTORES_ILUSTRADOS } from '../components/Ilustracion';
import { cargar, tarjetas, imagen } from '../lib/datos';
import Mapa from '../components/Mapa';
import { proyectar, puntosDe } from '../lib/mapa';
import { paraExplorador, txt } from '../lib/contenido';

const { datos } = await cargar();
const ejemplos = await tarjetas(datos.proyectos.filter((p) => ['planta-columbus', 'torre-grua-maceo'].includes(p.id)), 'es');
const laminaSuelta = await imagen(columbus, 'Patio de almacenamiento de la planta Columbus');
const todas = paraExplorador(datos.proyectos as never).map((p: any) => ({ coordenadas: p.data.coordenadas, titulo: p.data.es.titulo, pais: p.data.pais?.toLowerCase() }));
const puntos = puntosDe(todas);
const paisesObra = [...new Set(todas.flatMap((x) => (x.pais ? [x.pais] : [])))];
const sedes = datos.sedes.map((s) => { const [x, y] = proyectar(s.data.coordenadas); return { x, y, etiqueta: `${txt(s.data.nombre, 'es')} · ${s.data.ciudad}` }; });

const SECCIONES = [
  ['nosotros', 'Nosotros', 'L-01'], ['proyectos', 'Proyectos', 'L-02'], ['servicios', 'Servicios', 'L-03'],
  ['sectores', 'Sectores', 'L-04'], ['hse', 'HSE y calidad', 'L-05'], ['noticias', 'Noticias', 'L-06'],
];

const cantidades = [
  ['Excavaciones', '442.000', 'm³'],
  ['Rellenos', '117.000', 'm³'],
  ['Concreto', '95.000', 'm³'],
  ['Acero de refuerzo', '12.000', 't'],
  ['Estructura metálica', '8.300', 't'],
  ['Equipos', '18.600', 't'],
  ['Cables de baja y media tensión y control', '353.000', 'm'],
  ['Luminarias', '3.300', 'un'],
];
---
<Base titulo="Muestra de componentes" lang="es" seccion="proyectos" noindex>
  <div class="wrap muestra">
    <Encabezado
      nivel={1}
      codigo="P-01"
      titulo="Planta Columbus"
      entrada="Diseño, construcción, montaje y puesta en marcha de una planta de cemento de 5.250 t/día para Cementos Argos en Cartagena."
      medida="42 meses"
    >
      <Pod slot="pod" forma="rotulo" codigo="P-01" nombre="Proyectos" />
    </Encabezado>

    <Rotulo
      titulo="Ficha técnica"
      celdas={[
        { etiqueta: 'Cliente', valor: 'Cementos Argos S.A.' },
        { etiqueta: 'Ubicación', valor: 'Cartagena, Colombia' },
        { etiqueta: 'Sector', valor: 'Cemento' },
        { etiqueta: 'Duración', valor: '42 meses' },
        { etiqueta: 'Horas hombre', valor: '9.470.000' },
        { etiqueta: 'Producción', valor: '5.250 t/día' },
        { etiqueta: 'Rol de HL', valor: 'Consorcio' },
        { etiqueta: 'Años', valor: 'Por confirmar' },
      ]}
    />

    <figure class="foto-muestra">
      <Foto src={columbus} alt="Apiladora y banda transportadora bajo la cubierta del patio de almacenamiento de la planta Columbus" sizes="(min-width: 1200px) 1200px, 100vw" />
      <figcaption class="voz-datos">Planta Columbus · Foto del sitio actual; pie provisional</figcaption>
    </figure>

    <section class="bloque" id="pods">
      <Encabezado codigo="C-00" titulo="Pods de sección" entrada="P1 identifica, P2 estructura, P3 llama la atención. Cada uno toma el acento de su sección." />
      {SECCIONES.map(([id, nombre, codigo]) => (
        <div class="fila pods">
          <Pod forma="rotulo" seccion={id} codigo={codigo} nombre={nombre} />
          <Pod forma="eje" seccion={id} nombre={nombre} dato={codigo} />
          <Pod forma="senal" seccion={id} codigo={codigo} nombre={nombre} />
        </div>
      ))}
      <div class="con-eje">
        <Pod forma="eje" letra="B" nombre="Construcción y montaje" dato="3 líneas" />
        <p>Bloque con eje: la línea punteada baja por el borde mientras dura la subsección.</p>
      </div>
    </section>

    <section class="bloque" id="laminas">
      <Encabezado codigo="C-05" titulo="Lámina, tarjetas e ilustraciones" entrada="La foto va teñida con el acento de la sección y vuelve a color al pasar el cursor; sin foto, la línea estructural del sector." />
      <div class="con-lamina lamina-suelta"><Lamina imagen={laminaSuelta} sector="cemento" sizes="(min-width: 900px) 800px, 100vw" /></div>
      <div class="tarjetas-cont"><div class="tarjetas">{ejemplos.map((t) => <Tarjeta t={t} lang="es" />)}</div></div>
      <div class="ilustraciones" id="ilustraciones">
        {SECTORES_ILUSTRADOS.map((s) => <figure><Ilustracion sector={s} titulo={`Ilustración de ${s}`} /><figcaption class="voz-datos">{s}</figcaption></figure>)}
      </div>
    </section>

    <section class="bloque" id="mapa">
      <Encabezado codigo="C-06" titulo="Mapa de presencia" entrada="Países con obra en el acento de la sección, un punto por ciudad y las sedes." />
      <Mapa lang="es" paises={paisesObra} puntos={puntos} sedes={sedes} />
    </section>

    <section class="bloque">
      <Encabezado codigo="C-01" titulo="Cifras destacadas" />
      <Cifras items={[
        { valor: '9.470.000', etiqueta: 'Horas hombre' },
        { valor: '5.250', etiqueta: 't/día de clínker' },
        { valor: '95.000', etiqueta: 'm³ de concreto' },
        { valor: '8.300', etiqueta: 't de estructura' },
      ]} />
    </section>

    <section class="bloque">
      <Encabezado codigo="C-02" titulo="Cantidades de obra" entrada="Cantidades representativas del proyecto completo." />
      <Tabla titulo="Cantidades de obra de la planta Columbus">
        <thead><tr><th>Actividad</th><th class="num">Cantidad</th><th>Unidad</th></tr></thead>
        <tbody>
          {cantidades.map(([a, c, u]) => <tr><td>{a}</td><td class="num">{c}</td><td>{u}</td></tr>)}
        </tbody>
      </Tabla>
    </section>

    <section class="bloque">
      <Encabezado codigo="C-03" titulo="Estados y acciones" />
      <p class="fila">
        <Chip tipo="ok">Ficha completa</Chip>
        <Chip tipo="high">Año por confirmar</Chip>
        <Chip tipo="acc">Consorcio</Chip>
        <Chip tipo="crit">Sin fotos</Chip>
        <Chip tipo="med">Discreta</Chip>
      </p>
      <p class="fila">
        <Boton href="/contacto/">Solicitar cotización</Boton>
        <Boton variante="secundario" href="/proyectos/">Ver proyectos</Boton>
        <Boton variante="datos">Cemento</Boton>
        <Boton variante="datos">Colombia</Boton>
      </p>
      <Nota><strong>Dato por confirmar.</strong> El PDF de ECOHL reporta 12.000 t de estructura en 18 meses; se refiere a la fabricación, no al proyecto completo.</Nota>
    </section>

    <section class="bloque">
      <Encabezado codigo="C-04" titulo="Formulario" />
      <form class="formulario" onsubmit="return false">
        <Campo etiqueta="Nombre" nombre="nombre" requerido autocompletar="name" />
        <Campo etiqueta="Correo" nombre="correo" tipo="email" requerido autocompletar="email" error="Escriba un correo con @, por ejemplo nombre@empresa.com." />
        <Campo etiqueta="Mensaje" nombre="mensaje" tipo="textarea" />
        <Boton type="submit">Enviar solicitud</Boton>
      </form>
    </section>
  </div>
</Base>

<style>
  .muestra { display: grid; gap: var(--s6); padding-block: var(--s6); }
  .bloque { display: grid; gap: var(--s5); }
  .foto-muestra { margin: 0; display: grid; gap: var(--s2); }
  .foto-muestra figcaption { color: var(--muted); }
  .fila { display: flex; flex-wrap: wrap; gap: var(--s2); margin: 0; max-width: none; }
  .pods { align-items: center; gap: var(--s4); }
  .ilustraciones { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--s4); }
  .ilustraciones figure { margin: 0; display: grid; gap: var(--s2); background: var(--paper); padding: var(--s3); }
  .ilustraciones figcaption { color: var(--muted); }
  .formulario { display: grid; gap: var(--s4); max-width: 560px; }
  .formulario :global(.boton) { justify-self: start; }
</style>
